test "double" {
    assert(double(4) == 8)
    assert(double(-3) == -6)
}

test "is_even" {
    assert(is_even(10))
    assert(!is_even(7))
    assert(is_even(0))
}

test "average" {
    assert(average(2.0, 4.0) == 3.0)
}
