struct Person {
    str name
    int age
}

fn apply_twice(fn(int) -> int f, int x) -> int {
    return x                    // TODO: f of f of x
}

// youngest first
fn by_age([]Person people) -> []Person {
    // TODO: people.sort_by(fn(a, b) { ... })
    return people
}

// the names of everyone 18 or older
fn adults([]Person people) -> []str {
    []str names                 // TODO: filter, then map to the names
    return names
}

test "apply_twice" {
    assert(apply_twice(fn(int x) -> int { return x * 3 }, 2) == 18)
}

test "by_age and adults" {
    people := [Person("Ann", 31), Person("Bo", 12), Person("Cy", 18)]
    sorted := by_age(people)
    assert(sorted[0].name == "Bo" && sorted[2].name == "Ann")
    assert(adults(people).join(", ") == "Ann, Cy")
}
