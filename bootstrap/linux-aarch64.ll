@.str.7329 = private unnamed_addr constant [24982 x i8] c"// The Finch runtime: string and array helpers, input, files and runtime errors.\0A// It is embedded in the compiler, compiled once into a cache folder, and linked\0A// statically into every Finch program. Everything here is plain C with no state.\0A//\0A// Layout shared with the compiler (src/codegen.cpp):\0A//   str  = { char *ptr; int64 len; int64 cap }   ptr is always NUL-terminated\0A//          cap > 0  : heap memory owned by the value (cap bytes allocated)\0A//          cap == 0 : a string literal, valid forever, never written to\0A//          cap == -1: borrowed from C, must be copied before it is kept\0A//   []T  = { T *ptr;   int64 len; int64 cap }    owns ptr when cap > 0\0A//   map[K]V: see \22maps\22 below\0A\0A#include <ctype.h>\0A#include <errno.h>\0A#include <stdarg.h>\0A#include <stdint.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#ifndef _WIN32\0A#include <sys/wait.h>\0A#endif\0A\0Atypedef struct {\0A    char *ptr;\0A    int64_t len;\0A    int64_t cap;\0A} FStr;\0A\0Atypedef struct {\0A    void *ptr;\0A    int64_t len;\0A    int64_t cap;\0A} FArr;\0A\0Astatic char empty[1] = \22\22;\0A\0A// ---------- runtime errors ----------\0A\0A// A program that loads Finch libraries (finch build --shared) can take runtime errors over\0A// instead of the process exiting: finch_module_on_fatal(handler) in each library. The handler\0A// gets the message and must not return (longjmp out, or exit itself).\0Astatic void (*fatal_hook)(const char *msg);\0Avoid finch_on_fatal(void (*hook)(const char *msg)) { fatal_hook = hook; }\0A\0Astatic __attribute__((noreturn)) void fatal(const char *msg) {\0A    if (fatal_hook) fatal_hook(msg);\0A    fflush(stdout);\0A    fprintf(stderr, \22%s\5Cn\22, msg);\0A    exit(1);\0A}\0A\0A__attribute__((noreturn, cold)) void finch_panic(const char *file, int64_t line, const char *msg) {\0A    char full[1024];\0A    snprintf(full, sizeof full, \22%s:%lld: runtime error: %s\22, file, (long long)line, msg);\0A    fflush(stdout);\0A    fatal(full);\0A}\0A\0A__attribute__((noreturn, cold)) void finch_panic_index(const char *file, int64_t line, int64_t i, int64_t len) {\0A    char msg[128];\0A    snprintf(msg, sizeof msg, \22index %lld is out of range (the length is %lld)\22, (long long)i, (long long)len);\0A    finch_panic(file, line, msg);\0A}\0A\0Astatic void *must(void *p) {\0A    if (!p) {\0A        fflush(stdout);\0A        fatal(\22runtime error: out of memory\22);\0A    }\0A    return p;\0A}\0A\0Avoid *finch_alloc(int64_t n) { return must(malloc(n ? (size_t)n : 1)); }\0Avoid *finch_zalloc(int64_t n) { return must(calloc(1, n ? (size_t)n : 1)); }\0A\0A// ---------- strings ----------\0A\0Astatic void str_heap(FStr *out, const char *p, int64_t len) {\0A    char *m = finch_alloc(len + 1);\0A    if (len) memcpy(m, p, (size_t)len);\0A    m[len] = 0;\0A    out->ptr = m;\0A    out->len = len;\0A    out->cap = len + 1;\0A}\0A\0Astatic void str_static(FStr *out, const char *lit) {\0A    out->ptr = (char *)lit;\0A    out->len = (int64_t)strlen(lit);\0A    out->cap = 0;\0A}\0A\0A// A copy that can be kept: literals are shared, everything else is duplicated.\0Avoid finch_str_copy(FStr *out, const FStr *s) {\0A    if (s->cap == 0) *out = *s;\0A    else str_heap(out, s->ptr, s->len);\0A}\0A\0A// Make `s` writable (before s[i] = c).\0Avoid finch_str_own(FStr *s) {\0A    if (s->cap > 0) return;\0A    FStr t;\0A    str_heap(&t, s->ptr, s->len);\0A    *s = t;\0A}\0A\0Avoid finch_str_drop(FStr *s) {\0A    if (s->cap > 0) free(s->ptr);\0A}\0A\0Avoid finch_str_from_c(FStr *out, const char *p) {\0A    if (!p) {\0A        str_static(out, empty);\0A        return;\0A    }\0A    out->ptr = (char *)p;\0A    out->len = (int64_t)strlen(p);\0A    out->cap = -1;\0A}\0A\0Avoid finch_str_concat(FStr *out, const FStr *a, const FStr *b) {\0A    int64_t len = a->len + b->len;\0A    char *m = finch_alloc(len + 1);\0A    memcpy(m, a->ptr, (size_t)a->len);\0A    memcpy(m + a->len, b->ptr, (size_t)b->len);\0A    m[len] = 0;\0A    out->ptr = m;\0A    out->len = len;\0A    out->cap = len + 1;\0A}\0A\0Aint finch_str_eq(const FStr *a, const FStr *b) {\0A    return a->len == b->len && memcmp(a->ptr, b->ptr, (size_t)a->len) == 0;\0A}\0A\0Aint64_t finch_str_cmp(const FStr *a, const FStr *b) {\0A    int64_t n = a->len < b->len ? a->len : b->len;\0A    int c = memcmp(a->ptr, b->ptr, (size_t)n);\0A    if (c) return c < 0 ? -1 : 1;\0A    return a->len < b->len ? -1 : a->len > b->len;\0A}\0A\0Avoid finch_str_from_int(FStr *out, int64_t v) {\0A    char buf[32];\0A    int n = snprintf(buf, sizeof buf, \22%lld\22, (long long)v);\0A    str_heap(out, buf, n);\0A}\0A\0Avoid finch_str_from_uint(FStr *out, uint64_t v) {\0A    char buf[32];\0A    int n = snprintf(buf, sizeof buf, \22%llu\22, (unsigned long long)v);\0A    str_heap(out, buf, n);\0A}\0A\0Avoid finch_str_from_float(FStr *out, double v) {\0A    char buf[64];\0A    int n = snprintf(buf, sizeof buf, \22%g\22, v);\0A    str_heap(out, buf, n);\0A}\0A\0Avoid finch_str_from_char(FStr *out, char c) { str_heap(out, &c, 1); }\0A\0Avoid finch_str_from_bool(FStr *out, int b) { str_static(out, b ? \22true\22 : \22false\22); }\0A\0Astatic void number_error(char *msg, size_t size, const FStr *s, const char *kind) {\0A    snprintf(msg, size, \22can't turn \5C\22%.*s\5C\22 into %s\22, (int)(s->len > 100 ? 100 : s->len), s->ptr ? s->ptr : \22\22, kind);\0A}\0A\0Astatic int parse_int(const FStr *s, int64_t *out) {\0A    const char *p = s->ptr ? s->ptr : \22\22;\0A    while (isspace((unsigned char)*p)) p++;\0A    char *end;\0A    errno = 0;\0A    long long v = strtoll(p, &end, 10);\0A    while (isspace((unsigned char)*end)) end++;\0A    *out = v;\0A    return !(end == p || *end || errno == ERANGE);\0A}\0A\0Astatic int parse_float(const FStr *s, double *out) {\0A    const char *p = s->ptr ? s->ptr : \22\22;\0A    while (isspace((unsigned char)*p)) p++;\0A    char *end;\0A    double v = strtod(p, &end);\0A    while (isspace((unsigned char)*end)) end++;\0A    *out = v;\0A    return !(end == p || *end);\0A}\0A\0Aint64_t finch_str_to_int(const FStr *s, const char *file, int64_t line) {\0A    int64_t v;\0A    if (!parse_int(s, &v)) {\0A        char msg[200];\0A        number_error(msg, sizeof msg, s, \22int\22);\0A        finch_panic(file, line, msg);\0A    }\0A    return v;\0A}\0A\0Adouble finch_str_to_float(const FStr *s, const char *file, int64_t line) {\0A    double v;\0A    if (!parse_float(s, &v)) {\0A        char msg[200];\0A        number_error(msg, sizeof msg, s, \22float\22);\0A        finch_panic(file, line, msg);\0A    }\0A    return v;\0A}\0A\0A// ---------- errors as values: int(s) or 0, try read_file(p) ... ----------\0A// Each gives back 1 on success; on failure 0, with the message in *err.\0A\0Astatic void set_error(FStr *err, const char *msg) { str_heap(err, msg, (int64_t)strlen(msg)); }\0A\0Aint finch_str_try_int(const FStr *s, int64_t *out, FStr *err) {\0A    if (parse_int(s, out)) return 1;\0A    char msg[200];\0A    number_error(msg, sizeof msg, s, \22int\22);\0A    set_error(err, msg);\0A    *out = 0;\0A    return 0;\0A}\0A\0Aint finch_str_try_float(const FStr *s, double *out, FStr *err) {\0A    if (parse_float(s, out)) return 1;\0A    char msg[200];\0A    number_error(msg, sizeof msg, s, \22float\22);\0A    set_error(err, msg);\0A    *out = 0;\0A    return 0;\0A}\0A\0Astatic void file_error(FStr *err, const char *what, const FStr *path) {\0A    char msg[300];\0A    snprintf(msg, sizeof msg, \22can't %s the file \5C\22%.*s\5C\22: %s\22, what, (int)(path->len > 200 ? 200 : path->len),\0A             path->ptr ? path->ptr : \22\22, strerror(errno));\0A    set_error(err, msg);\0A}\0A\0A// when `fn main() -> !` fails\0Avoid finch_report_error(const FStr *msg) {\0A    fflush(stdout);\0A    fprintf(stderr, \22error: %.*s\5Cn\22, (int)msg->len, msg->ptr ? msg->ptr : \22\22);\0A}\0A\0Avoid finch_str_sub(FStr *out, const FStr *s, int64_t start, int64_t end, const char *file, int64_t line) {\0A    if (start < 0 || end > s->len || start > end) {\0A        char msg[160];\0A        snprintf(msg, sizeof msg, \22sub(%lld, %lld) is out of range (the length is %lld)\22, (long long)start,\0A                 (long long)end, (long long)s->len);\0A        finch_panic(file, line, msg);\0A    }\0A    str_heap(out, s->ptr + start, end - start);\0A}\0A\0Aint64_t finch_str_find(const FStr *s, const FStr *t) {\0A    if (t->len == 0) return 0;\0A    for (int64_t i = 0; i + t->len <= s->len; i++)\0A        if (s->ptr[i] == t->ptr[0] && memcmp(s->ptr + i, t->ptr, (size_t)t->len) == 0) return i;\0A    return -1;\0A}\0A\0Aint finch_str_starts(const FStr *s, const FStr *t) {\0A    return t->len <= s->len && memcmp(s->ptr, t->ptr, (size_t)t->len) == 0;\0A}\0A\0Aint finch_str_ends(const FStr *s, const FStr *t) {\0A    return t->len <= s->len && memcmp(s->ptr + s->len - t->len, t->ptr, (size_t)t->len) == 0;\0A}\0A\0Avoid finch_str_trim(FStr *out, const FStr *s) {\0A    int64_t a = 0, b = s->len;\0A    while (a < b && isspace((unsigned char)s->ptr[a])) a++;\0A    while (b > a && isspace((unsigned char)s->ptr[b - 1])) b--;\0A    str_heap(out, s->ptr + a, b - a);\0A}\0A\0Avoid finch_str_upper(FStr *out, const FStr *s) {\0A    str_heap(out, s->ptr, s->len);\0A    for (int64_t i = 0; i < out->len; i++) out->ptr[i] = (char)toupper((unsigned char)out->ptr[i]);\0A}\0A\0Avoid finch_str_lower(FStr *out, const FStr *s) {\0A    str_heap(out, s->ptr, s->len);\0A    for (int64_t i = 0; i < out->len; i++) out->ptr[i] = (char)tolower((unsigned char)out->ptr[i]);\0A}\0A\0Avoid finch_str_replace(FStr *out, const FStr *s, const FStr *from, const FStr *to) {\0A    if (from->len == 0) {\0A        str_heap(out, s->ptr, s->len);\0A        return;\0A    }\0A    int64_t count = 0;\0A    for (int64_t i = 0; i + from->len <= s->len;) {\0A        if (memcmp(s->ptr + i, from->ptr, (size_t)from->len) == 0) {\0A            count++;\0A            i += from->len;\0A        } else {\0A            i++;\0A        }\0A    }\0A    int64_t len = s->len + count * (to->len - from->len);\0A    char *m = finch_alloc(len + 1), *w = m;\0A    for (int64_t i = 0; i < s->len;) {\0A        if (i + from->len <= s->len && memcmp(s->ptr + i, from->ptr, (size_t)from->len) == 0) {\0A            memcpy(w, to->ptr, (size_t)to->len);\0A            w += to->len;\0A            i += from->len;\0A        } else {\0A            *w++ = s->ptr[i++];\0A        }\0A    }\0A    *w = 0;\0A    out->ptr = m;\0A    out->len = len;\0A    out->cap = len + 1;\0A}\0A\0Astatic void arr_push_str(FArr *a, const char *p, int64_t len);\0A\0A// \22a,b,,c\22.split(\22,\22) -> [\22a\22, \22b\22, \22\22, \22c\22]; split(\22\22) gives single characters.\0Avoid finch_str_split(FArr *out, const FStr *s, const FStr *sep) {\0A    out->ptr = NULL;\0A    out->len = out->cap = 0;\0A    if (sep->len == 0) {\0A        for (int64_t i = 0; i < s->len; i++) arr_push_str(out, s->ptr + i, 1);\0A        return;\0A    }\0A    int64_t start = 0;\0A    for (int64_t i = 0; i + sep->len <= s->len;) {\0A        if (memcmp(s->ptr + i, sep->ptr, (size_t)sep->len) == 0) {\0A            arr_push_str(out, s->ptr + start, i - start);\0A            i += sep->len;\0A            start = i;\0A        } else {\0A            i++;\0A        }\0A    }\0A    arr_push_str(out, s->ptr + start, s->len - start);\0A}\0A\0Avoid finch_str_join(FStr *out, const FArr *parts, const FStr *sep) {\0A    const FStr *p = parts->ptr;\0A    int64_t len = 0;\0A    for (int64_t i = 0; i < parts->len; i++) len += p[i].len + (i ? sep->len : 0);\0A    char *m = finch_alloc(len + 1), *w = m;\0A    for (int64_t i = 0; i < parts->len; i++) {\0A        if (i) {\0A            memcpy(w, sep->ptr, (size_t)sep->len);\0A            w += sep->len;\0A        }\0A        memcpy(w, p[i].ptr, (size_t)p[i].len);\0A        w += p[i].len;\0A    }\0A    *w = 0;\0A    out->ptr = m;\0A    out->len = len;\0A    out->cap = len + 1;\0A}\0A\0Avoid finch_str_repeat(FStr *out, const FStr *s, int64_t n) {\0A    if (n < 0) n = 0;\0A    int64_t len = s->len * n;\0A    char *m = finch_alloc(len + 1);\0A    for (int64_t i = 0; i < n; i++) memcpy(m + i * s->len, s->ptr, (size_t)s->len);\0A    m[len] = 0;\0A    out->ptr = m;\0A    out->len = len;\0A    out->cap = len + 1;\0A}\0A\0Avoid finch_str_from_bytes(FStr *out, const FArr *bytes) { str_heap(out, bytes->ptr, bytes->len); }\0A\0A// ---------- building text: print(x) and str(x) of arrays, maps and structs ----------\0A// A buffer starts as an empty str and grows on the heap.\0A\0Avoid finch_buf_add(FStr *b, const char *p, int64_t n) {\0A    if (b->len + n + 1 > b->cap) {\0A        int64_t cap = b->cap > 0 ? b->cap * 2 : 32;\0A        while (cap < b->len + n + 1) cap *= 2;\0A        b->ptr = must(realloc(b->cap > 0 ? b->ptr : NULL, (size_t)cap));\0A        b->cap = cap;\0A    }\0A    if (n) memcpy(b->ptr + b->len, p, (size_t)n);\0A    b->len += n;\0A    b->ptr[b->len] = 0;\0A}\0A\0Astatic void buf_fmt(FStr *b, const char *fmt, ...) __attribute__((format(printf, 2, 3)));\0Astatic void buf_fmt(FStr *b, const char *fmt, ...) {\0A    char t[64];\0A    va_list ap;\0A    va_start(ap, fmt);\0A    int n = vsnprintf(t, sizeof t, fmt, ap);\0A    va_end(ap);\0A    finch_buf_add(b, t, n);\0A}\0A\0Avoid finch_buf_int(FStr *b, int64_t v) { buf_fmt(b, \22%lld\22, (long long)v); }\0Avoid finch_buf_uint(FStr *b, uint64_t v) { buf_fmt(b, \22%llu\22, (unsigned long long)v); }\0Avoid finch_buf_float(FStr *b, double v) { buf_fmt(b, \22%g\22, v); }\0Avoid finch_buf_bool(FStr *b, int v) { finch_buf_add(b, v ? \22true\22 : \22false\22, v ? 4 : 5); }\0Avoid finch_buf_ptr(FStr *b, const void *p) {\0A    if (p) buf_fmt(b, \220x%llx\22, (unsigned long long)(uintptr_t)p);\0A    else finch_buf_add(b, \22null\22, 4);\0A}\0A\0Avoid finch_buf_char(FStr *b, char c, int quoted) {\0A    if (quoted) finch_buf_add(b, \22'\22, 1);\0A    finch_buf_add(b, &c, 1);\0A    if (quoted) finch_buf_add(b, \22'\22, 1);\0A}\0A\0Avoid finch_buf_str(FStr *b, const FStr *s, int quoted) {\0A    if (quoted) finch_buf_add(b, \22\5C\22\22, 1);\0A    finch_buf_add(b, s->ptr, s->len);\0A    if (quoted) finch_buf_add(b, \22\5C\22\22, 1);\0A}\0A\0A// print the buffer and free it\0Avoid finch_buf_print(FStr *b) {\0A    if (b->len) fwrite(b->ptr, 1, (size_t)b->len, stdout);\0A    if (b->cap > 0) free(b->ptr);\0A}\0A\0A// ---------- arrays ----------\0A\0Avoid finch_arr_reserve(FArr *a, int64_t need, int64_t es) {\0A    if (need <= a->cap) return;\0A    int64_t cap = a->cap * 2;\0A    if (cap < 4) cap = 4;\0A    if (cap < need) cap = need;\0A    a->ptr = must(realloc(a->cap > 0 ? a->ptr : NULL, (size_t)(cap * es)));\0A    a->cap = cap;\0A}\0A\0Avoid finch_arr_make(FArr *out, int64_t len, int64_t es) {\0A    if (len < 0) len = 0;\0A    out->ptr = len ? finch_zalloc(len * es) : NULL;\0A    out->len = len;\0A    out->cap = len;\0A}\0A\0A// grow or shrink to `len`; new elements are zero\0Avoid finch_arr_resize(FArr *a, int64_t len, int64_t es) {\0A    if (len < 0) len = 0;\0A    finch_arr_reserve(a, len, es);\0A    if (len > a->len) memset((char *)a->ptr + a->len * es, 0, (size_t)((len - a->len) * es));\0A    a->len = len;\0A}\0A\0A// a byte-for-byte copy of the elements (the compiler deep-copies owning elements afterwards)\0Avoid finch_arr_clone_raw(FArr *out, const FArr *a, int64_t es) {\0A    out->len = a->len;\0A    out->cap = a->len;\0A    out->ptr = a->len ? finch_alloc(a->len * es) : NULL;\0A    if (a->len) memcpy(out->ptr, a->ptr, (size_t)(a->len * es));\0A}\0A\0Avoid finch_arr_free(FArr *a) {\0A    if (a->cap > 0) free(a->ptr);\0A}\0A\0A// open a hole at i (0 <= i <= len), len grows by one\0Avoid finch_arr_insert_gap(FArr *a, int64_t i, int64_t es, const char *file, int64_t line) {\0A    if (i < 0 || i > a->len) finch_panic_index(file, line, i, a->len);\0A    finch_arr_reserve(a, a->len + 1, es);\0A    char *p = a->ptr;\0A    memmove(p + (i + 1) * es, p + i * es, (size_t)((a->len - i) * es));\0A    a->len++;\0A}\0A\0A// close the hole at i (the element was already moved out), len shrinks by one\0Avoid finch_arr_remove_gap(FArr *a, int64_t i, int64_t es) {\0A    char *p = a->ptr;\0A    memmove(p + i * es, p + (i + 1) * es, (size_t)((a->len - i - 1) * es));\0A    a->len--;\0A}\0A\0Astatic void arr_push_str(FArr *a, const char *p, int64_t len) {\0A    finch_arr_reserve(a, a->len + 1, (int64_t)sizeof(FStr));\0A    str_heap((FStr *)a->ptr + a->len, p, len);\0A    a->len++;\0A}\0A\0Avoid finch_bytes_from_str(FArr *out, const FStr *s) {\0A    out->len = out->cap = s->len;\0A    out->ptr = s->len ? finch_alloc(s->len) : NULL;\0A    if (s->len) memcpy(out->ptr, s->ptr, (size_t)s->len);\0A}\0A\0A// ---------- program arguments, input and files ----------\0A\0Avoid finch_args(FArr *out, int argc, char **argv) {\0A    out->len = out->cap = argc;\0A    out->ptr = finch_alloc((int64_t)sizeof(FStr) * (argc ? argc : 1));\0A    for (int i = 0; i < argc; i++) str_heap((FStr *)out->ptr + i, argv[i], (int64_t)strlen(argv[i]));\0A}\0A\0A// input(\22Name? \22) prints the prompt and reads one line, without the newline.\0Avoid finch_input(FStr *out, const FStr *prompt) {\0A    if (prompt->len) fwrite(prompt->ptr, 1, (size_t)prompt->len, stdout);\0A    fflush(stdout);\0A    // read one line of any length (getline isn't available everywhere)\0A    size_t size = 128, n = 0;\0A    char *line = finch_alloc((int64_t)size);\0A    int c, got = 0;\0A    while ((c = fgetc(stdin)) != EOF) {\0A        got = 1;\0A        if (c == '\5Cn') break;\0A        if (n + 1 >= size) line = must(realloc(line, size *= 2));\0A        line[n++] = (char)c;\0A    }\0A    if (!got) {\0A        free(line);\0A        str_static(out, empty);\0A        return;\0A    }\0A    while (n > 0 && line[n - 1] == '\5Cr') n--;\0A    line[n] = 0;\0A    out->ptr = line;\0A    out->len = (int64_t)n;\0A    out->cap = (int64_t)size;\0A}\0A\0Aint finch_file_exists(const FStr *path) {\0A    FILE *f = fopen(path->ptr, \22rb\22);\0A    if (f) fclose(f);\0A    return f != NULL;\0A}\0A\0Aint finch_try_read_file(FStr *out, const FStr *path, FStr *err) {\0A    FILE *f = fopen(path->ptr ? path->ptr : \22\22, \22rb\22);\0A    if (!f) {\0A        file_error(err, \22read\22, path);\0A        return 0;\0A    }\0A    fseek(f, 0, SEEK_END);\0A    long size = ftell(f);\0A    fseek(f, 0, SEEK_SET);\0A    char *m = finch_alloc(size + 1);\0A    size_t got = fread(m, 1, (size_t)size, f);\0A    fclose(f);\0A    m[got] = 0;\0A    out->ptr = m;\0A    out->len = (int64_t)got;\0A    out->cap = size + 1;\0A    return 1;\0A}\0A\0Avoid finch_read_file(FStr *out, const FStr *path, const char *file, int64_t line) {\0A    FILE *f = fopen(path->ptr ? path->ptr : \22\22, \22rb\22);\0A    if (!f) {\0A        char msg[300];\0A        snprintf(msg, sizeof msg, \22can't read the file \5C\22%.*s\5C\22: %s\22, (int)(path->len > 200 ? 200 : path->len),\0A                 path->ptr, strerror(errno));\0A        finch_panic(file, line, msg);\0A    }\0A    fseek(f, 0, SEEK_END);\0A    long size = ftell(f);\0A    fseek(f, 0, SEEK_SET);\0A    char *m = finch_alloc(size + 1);\0A    size_t got = fread(m, 1, (size_t)size, f);\0A    fclose(f);\0A    m[got] = 0;\0A    out->ptr = m;\0A    out->len = (int64_t)got;\0A    out->cap = size + 1;\0A}\0A\0A// shell(\22ls -l\22): run a command, give back its exit code\0Aint64_t finch_shell(const FStr *cmd) {\0A    fflush(stdout);\0A    int status = system(cmd->ptr ? cmd->ptr : \22\22);\0A#ifdef _WIN32\0A    return status;  // Windows gives the exit code directly\0A#else\0A    if (status == -1) return -1;\0A    if (WIFEXITED(status)) return WEXITSTATUS(status);\0A    return 128 + (WIFSIGNALED(status) ? WTERMSIG(status) : 0);\0A#endif\0A}\0A\0Aint finch_delete_file(const FStr *path) { return remove(path->ptr ? path->ptr : \22\22) == 0; }\0A\0Aint finch_try_delete_file(const FStr *path, FStr *err) {\0A    if (remove(path->ptr ? path->ptr : \22\22) == 0) return 1;\0A    file_error(err, \22delete\22, path);\0A    return 0;\0A}\0A\0A// stdin/stdout/stderr are macros on some systems (Windows), so Finch asks for them here\0Avoid *finch_std_stream(int i) { return i == 0 ? (void *)stdin : i == 1 ? (void *)stdout : (void *)stderr; }\0A\0Aint finch_write_file(const FStr *path, const FStr *text) {\0A    FILE *f = fopen(path->ptr ? path->ptr : \22\22, \22wb\22);\0A    if (!f) return 0;\0A    size_t put = text->len ? fwrite(text->ptr, 1, (size_t)text->len, f) : 0;\0A    return fclose(f) == 0 && put == (size_t)text->len;\0A}\0A\0Aint finch_try_write_file(const FStr *path, const FStr *text, FStr *err) {\0A    errno = 0;\0A    if (finch_write_file(path, text)) return 1;\0A    if (!errno) errno = EIO;\0A    file_error(err, \22write\22, path);\0A    return 0;\0A}\0A\0A// ---------- maps ----------\0A// map[K]V = { entries; len; used; cap; index; icap; adds }\0A//   entries: `used` slots of es bytes, each { uint64 hash; K key; V value }, in insertion order.\0A//            A removed entry keeps its slot (hash 0) until the next resize packs the slots.\0A//   index:   icap slots (a power of two, at least 2 * cap): -1 empty, -2 removed, else an entry number.\0A//   adds:    how many keys were ever added; a `for` over the map stops with an error if it changes.\0A// The compiler stores, copies and drops keys and values; the runtime only finds and places entries.\0A// Keys are compared byte for byte (numbers, chars, bools) or as text (kstr).\0A\0Atypedef struct {\0A    char *entries;\0A    int64_t len, used, cap;\0A    int64_t *index;\0A    int64_t icap;\0A    int64_t adds;\0A} FMap;\0A\0Astatic uint64_t map_hash(const void *key, int64_t ks, int kstr) {\0A    const unsigned char *p;\0A    size_t n;\0A    if (kstr) {\0A        const FStr *s = key;\0A        p = (const unsigned char *)s->ptr;\0A        n = (size_t)s->len;\0A    } else {\0A        p = key;\0A        n = (size_t)ks;\0A    }\0A    uint64_t h = 1469598103934665603ULL;  // FNV-1a, then mixed so the low bits spread well\0A    for (size_t i = 0; i < n; i++) {\0A        h ^= p[i];\0A        h *= 1099511628211ULL;\0A    }\0A    h ^= h >> 31;\0A    h *= 0xbf58476d1ce4e5b9ULL;\0A    h ^= h >> 29;\0A    return h | 1;  // 0 marks a removed entry\0A}\0A\0Astatic int map_key_eq(const char *a, const void *b, int64_t ks, int kstr) {\0A    if (!kstr) return memcmp(a, b, (size_t)ks) == 0;\0A    const FStr *x = (const FStr *)a, *y = b;\0A    return x->len == y->len && (x->len == 0 || memcmp(x->ptr, y->ptr, (size_t)x->len) == 0);\0A}\0A\0Astatic void map_reindex(FMap *m, int64_t es) {\0A    if (m->len != m->used) {  // pack the slots of removed entries away\0A        int64_t j = 0;\0A        for (int64_t i = 0; i < m->used; i++) {\0A            char *e = m->entries + i * es;\0A            if (*(uint64_t *)e == 0) continue;\0A            if (i != j) memmove(m->entries + j * es, e, (size_t)es);\0A            j++;\0A        }\0A        m->used = j;\0A    }\0A    int64_t icap = 16;\0A    while (icap < m->cap * 2) icap *= 2;\0A    free(m->index);\0A    m->index = finch_alloc(icap * (int64_t)sizeof(int64_t));\0A    memset(m->index, 0xff, (size_t)icap * sizeof(int64_t));\0A    m->icap = icap;\0A    for (int64_t i = 0; i < m->used; i++) {\0A        uint64_t h = *(uint64_t *)(m->entries + i * es);\0A        int64_t s = (int64_t)(h & (uint64_t)(icap - 1));\0A        while (m->index[s] != -1) s = (s + 1) & (icap - 1);\0A        m->index[s] = i;\0A    }\0A}\0A\0A// the entry number of `key`, or -1\0Aint64_t finch_map_find(const FMap *m, const void *key, int64_t es, int64_t ks, int32_t kstr) {\0A    if (m->len == 0) return -1;\0A    uint64_t h = map_hash(key, ks, kstr);\0A    for (int64_t s = (int64_t)(h & (uint64_t)(m->icap - 1));; s = (s + 1) & (m->icap - 1)) {\0A        int64_t i = m->index[s];\0A        if (i == -1) return -1;\0A        if (i < 0) continue;\0A        char *e = m->entries + i * es;\0A        if (*(uint64_t *)e == h && map_key_eq(e + 8, key, ks, kstr)) return i;\0A    }\0A}\0A\0A// The entry for `key`. A new one is zeroed except its hash (*added = 1); the compiler then stores the key.\0Aint64_t finch_map_slot(FMap *m, const void *key, int64_t es, int64_t ks, int32_t kstr, int32_t *added) {\0A    int64_t i = finch_map_find(m, key, es, ks, kstr);\0A    *added = i < 0;\0A    if (i >= 0) return i;\0A    if (m->used == m->cap) {\0A        if (m->len * 4 < m->cap * 3) {  // many removed slots: pack them instead of growing\0A            map_reindex(m, es);\0A        } else {\0A            m->cap = m->cap ? m->cap * 2 : 8;\0A            m->entries = must(realloc(m->entries, (size_t)(m->cap * es)));\0A            map_reindex(m, es);\0A        }\0A    }\0A    uint64_t h = map_hash(key, ks, kstr);\0A    i = m->used++;\0A    char *e = m->entries + i * es;\0A    memset(e, 0, (size_t)es);\0A    *(uint64_t *)e = h;\0A    int64_t s = (int64_t)(h & (uint64_t)(m->icap - 1));\0A    while (m->index[s] >= 0) s = (s + 1) & (m->icap - 1);\0A    m->index[s] = i;\0A    m->len++;\0A    m->adds++;\0A    return i;\0A}\0A\0A// Forget entry i (its key and value were already dropped by the compiler).\0Avoid finch_map_remove_at(FMap *m, int64_t i, int64_t es) {\0A    char *e = m->entries + i * es;\0A    uint64_t h = *(uint64_t *)e;\0A    int64_t s = (int64_t)(h & (uint64_t)(m->icap - 1));\0A    while (m->index[s] != i) s = (s + 1) & (m->icap - 1);\0A    m->index[s] = -2;\0A    *(uint64_t *)e = 0;\0A    if (--m->len == 0) {\0A        m->used = 0;\0A        memset(m->index, 0xff, (size_t)m->icap * sizeof(int64_t));\0A    }\0A}\0A\0Avoid finch_map_clear(FMap *m) {\0A    m->len = m->used = 0;\0A    if (m->index) memset(m->index, 0xff, (size_t)m->icap * sizeof(int64_t));\0A}\0A\0Avoid finch_map_free(FMap *m) {\0A    free(m->entries);\0A    free(m->index);\0A}\0A\0A// A copy of the slots and the index; the compiler then copies the keys and values that own memory.\0Avoid finch_map_clone_raw(FMap *out, const FMap *m, int64_t es) {\0A    *out = *m;\0A    if (!m->cap) return;\0A    out->entries = finch_alloc(m->cap * es);\0A    memcpy(out->entries, m->entries, (size_t)(m->used * es));\0A    out->index = finch_alloc(m->icap * (int64_t)sizeof(int64_t));\0A    memcpy(out->index, m->index, (size_t)m->icap * sizeof(int64_t));\0A}\0A\0A__attribute__((noreturn, cold)) void finch_map_changed(const char *file, int64_t line) {\0A    finch_panic(file, line, \22a key was added to the map while looping over it (collect the new keys, and add them after the loop)\22);\0A}\0A\0A__attribute__((noreturn, cold)) void finch_map_missing(const char *file, int64_t line, const FStr *key) {\0A    char msg[200];\0A    snprintf(msg, sizeof msg, \22the key %.*s is not in the map (check with .has(key), or use .get(key, default))\22,\0A             (int)(key->len > 100 ? 100 : key->len), key->ptr ? key->ptr : \22\22);\0A    finch_panic(file, line, msg);\0A}\0A\00"
@.str.7330 = private unnamed_addr constant [12885 x i8] c"// JSON: read it, build it, write it.\0A//\0A//   import json\0A//\0A//   doc := try json.parse(\22{\5C\22name\5C\22: \5C\22Finch\5C\22, \5C\22tags\5C\22: [\5C\22fast\5C\22, \5C\22small\5C\22], \5C\22stars\5C\22: 5}\22)\0A//   print(doc.get(\22name\22).str_or(\22\22))             Finch\0A//   print(doc.get(\22tags\22).at(1).str_or(\22\22))       small\0A//   print(doc.get(\22stars\22).int_or(0))             5\0A//   print(doc.get(\22missing\22).is_null())           true       (a missing key is null, so chains never fail)\0A//\0A//   out := json.new_object()\0A//   out.set(\22ok\22, json.new_bool(true))\0A//   list := json.new_list()\0A//   list.push(json.new_number(1.5))\0A//   out.set(\22values\22, list)\0A//   print(json.stringify(out))                    {\22ok\22:true,\22values\22:[1.5]}\0A//   print(json.pretty(out))                       the same, over several lines\0A\0Aenum Kind { Null, Bool, Number, Text, List, Object }\0A\0A// One JSON value. `kind` says which of the other fields it uses: flag for Bool, num for Number,\0A// text for Text, items for List, and items with keys (the same length, in the same order) for Object.\0Astruct Json {\0A    Kind kind\0A    bool flag\0A    float num\0A    str text\0A    []Json items\0A    []str keys\0A}\0A\0Afn new_null() -> Json {\0A    return Json(kind: Kind.Null)\0A}\0A\0Afn new_bool(bool b) -> Json {\0A    return Json(kind: Kind.Bool, flag: b)\0A}\0A\0Afn new_number(float n) -> Json {\0A    return Json(kind: Kind.Number, num: n)\0A}\0A\0Afn new_text(str s) -> Json {\0A    return Json(kind: Kind.Text, text: s)\0A}\0A\0Afn new_list() -> Json {\0A    return Json(kind: Kind.List)\0A}\0A\0Afn new_object() -> Json {\0A    return Json(kind: Kind.Object)\0A}\0A\0A// ---------- looking inside ----------\0A\0Afn Json.is_null() -> bool {\0A    return self.kind == Kind.Null\0A}\0A\0A// the number of elements of a list, of keys of an object, of bytes of a text; 0 for the rest\0Afn Json.len() -> int {\0A    return match self.kind {\0A        List, Object -> self.items.len\0A        Text -> self.text.len\0A        else -> 0\0A    }\0A}\0A\0Afn Json.has(str key) -> bool {\0A    return self.kind == Kind.Object && self.keys.contains(key)\0A}\0A\0A// the value of a key of an object; null if there is none (or this is not an object)\0Afn Json.get(str key) -> Json {\0A    if self.kind != Kind.Object {\0A        return new_null()\0A    }\0A    i := self.keys.find(key)\0A    if i < 0 {\0A        return new_null()\0A    }\0A    return self.items[i]\0A}\0A\0A// the element of a list; null if there is none\0Afn Json.at(int i) -> Json {\0A    if self.kind != Kind.List || i < 0 || i >= self.items.len {\0A        return new_null()\0A    }\0A    return self.items[i]\0A}\0A\0A// the value if it is of that kind, else what was given\0Afn Json.str_or(str fallback) -> str {\0A    if self.kind == Kind.Text {\0A        return self.text\0A    }\0A    return fallback\0A}\0A\0Afn Json.float_or(float fallback) -> float {\0A    if self.kind == Kind.Number {\0A        return self.num\0A    }\0A    return fallback\0A}\0A\0Afn Json.int_or(int fallback) -> int {\0A    if self.kind == Kind.Number {\0A        return int(self.num)\0A    }\0A    return fallback\0A}\0A\0Afn Json.bool_or(bool fallback) -> bool {\0A    if self.kind == Kind.Bool {\0A        return self.flag\0A    }\0A    return fallback\0A}\0A\0A// the keys of an object, in the order they were written\0Afn Json.names() -> []str {\0A    return self.keys\0A}\0A\0A// ---------- building ----------\0A\0A// add to the end of a list\0Afn Json.push(Json v) {\0A    self.items.push(v)\0A}\0A\0A// give a key a value in an object; a key that is already there is replaced\0Afn Json.set(str key, Json v) {\0A    i := self.keys.find(key)\0A    if i >= 0 {\0A        self.items[i] = v\0A        return\0A    }\0A    self.keys.push(key)\0A    self.items.push(v)\0A}\0A\0A// ---------- writing ----------\0A\0Afn quote(str s) -> str {\0A    []str parts = [\22\5C\22\22]\0A    for c in s {\0A        n := int(c)\0A        if c == '\22' {\0A            parts.push(\22\5C\5C\5C\22\22)\0A        } else if c == '\5C\5C' {\0A            parts.push(\22\5C\5C\5C\5C\22)\0A        } else if c == '\5Cn' {\0A            parts.push(\22\5C\5Cn\22)\0A        } else if c == '\5Cr' {\0A            parts.push(\22\5C\5Cr\22)\0A        } else if c == '\5Ct' {\0A            parts.push(\22\5C\5Ct\22)\0A        } else if n < 32 {\0A            parts.push(\22\5C\5Cu00\22 + hexdigit(n / 16) + hexdigit(n % 16))\0A        } else {\0A            parts.push(str(c))\0A        }\0A    }\0A    parts.push(\22\5C\22\22)\0A    return parts.join(\22\22)\0A}\0A\0Afn hexdigit(int n) -> str {\0A    digits := \220123456789abcdef\22\0A    return str(digits[n])\0A}\0A\0Afn number_text(float n) -> str {\0A    if n == float(int(n)) && n > -1000000000000000.0 && n < 1000000000000000.0 {\0A        return str(int(n))\0A    }\0A    return str(n)\0A}\0A\0Astruct Writer {\0A    []str out\0A}\0A\0Afn write(Json j, str indent, str pad, ptr[Writer] w) {\0A    nl := \22\22\0A    inner := \22\22\0A    sep := \22,\22\0A    colon := \22:\22\0A    if indent.len > 0 {\0A        nl = \22\5Cn\22\0A        inner = pad + indent\0A        colon = \22: \22\0A    }\0A    match j.kind {\0A        Null -> w.out.push(\22null\22)\0A        Bool -> {\0A            if j.flag {\0A                w.out.push(\22true\22)\0A            } else {\0A                w.out.push(\22false\22)\0A            }\0A        }\0A        Number -> w.out.push(number_text(j.num))\0A        Text -> w.out.push(quote(j.text))\0A        List -> {\0A            if j.items.len == 0 {\0A                w.out.push(\22[]\22)\0A                return\0A            }\0A            w.out.push(\22[\22 + nl)\0A            for i, item in j.items {\0A                if i > 0 {\0A                    w.out.push(sep + nl)\0A                }\0A                w.out.push(inner)\0A                write(item, indent, inner, w)\0A            }\0A            w.out.push(nl + pad + \22]\22)\0A        }\0A        Object -> {\0A            if j.items.len == 0 {\0A                w.out.push(\22{}\22)\0A                return\0A            }\0A            w.out.push(\22{\22 + nl)\0A            for i, item in j.items {\0A                if i > 0 {\0A                    w.out.push(sep + nl)\0A                }\0A                w.out.push(inner + quote(j.keys[i]) + colon)\0A                write(item, indent, inner, w)\0A            }\0A            w.out.push(nl + pad + \22}\22)\0A        }\0A    }\0A}\0A\0A// the value as text on one line\0Afn stringify(Json j) -> str {\0A    w := Writer()\0A    write(j, \22\22, \22\22, addr(w))\0A    return w.out.join(\22\22)\0A}\0A\0A// the value as text over several lines, indented by two spaces\0Afn pretty(Json j) -> str {\0A    w := Writer()\0A    write(j, \22  \22, \22\22, addr(w))\0A    return w.out.join(\22\22)\0A}\0A\0A// ---------- reading ----------\0A\0Astruct Reader {\0A    str src\0A    int i\0A}\0A\0A// the line and column of a position, for a message\0Afn where(ptr[Reader] r) -> str {\0A    line := 1\0A    col := 1\0A    for k in 0..r.i {\0A        if k < r.src.len && r.src[k] == '\5Cn' {\0A            line += 1\0A            col = 1\0A        } else {\0A            col += 1\0A        }\0A    }\0A    return \22line \22 + str(line) + \22, column \22 + str(col)\0A}\0A\0Afn peek(ptr[Reader] r) -> char {\0A    if r.i < r.src.len {\0A        return r.src[r.i]\0A    }\0A    return char(0)\0A}\0A\0Afn skip_space(ptr[Reader] r) {\0A    while r.i < r.src.len && (r.src[r.i] == ' ' || r.src[r.i] == '\5Cn' || r.src[r.i] == '\5Ct' || r.src[r.i] == '\5Cr') {\0A        r.i += 1\0A    }\0A}\0A\0Afn unexpected(ptr[Reader] r, str wanted) -> str {\0A    if r.i >= r.src.len {\0A        return \22json: the text ends where \22 + wanted + \22 should be (\22 + where(r) + \22)\22\0A    }\0A    return \22json: found '\22 + str(r.src[r.i]) + \22' where \22 + wanted + \22 should be (\22 + where(r) + \22)\22\0A}\0A\0A// does `word` come next?\0Afn comes(ptr[Reader] r, str word) -> bool {\0A    return r.src.len - r.i >= word.len && r.src.sub(r.i, r.i + word.len) == word\0A}\0A\0Afn expect_word(ptr[Reader] r, str word) -> ! {\0A    if !comes(r, word) {\0A        return error(unexpected(r, \22'\22 + word + \22'\22))\0A    }\0A    r.i += word.len\0A}\0A\0Afn hex_value(char c) -> int {\0A    if c >= '0' && c <= '9' {\0A        return int(c) - int('0')\0A    }\0A    if c >= 'a' && c <= 'f' {\0A        return int(c) - int('a') + 10\0A    }\0A    if c >= 'A' && c <= 'F' {\0A        return int(c) - int('A') + 10\0A    }\0A    return -1\0A}\0A\0A// a code point as UTF-8\0Afn utf8(int cp) -> str {\0A    []u8 b\0A    if cp < 128 {\0A        b.push(u8(cp))\0A    } else if cp < 2048 {\0A        b.push(u8(192 + cp / 64))\0A        b.push(u8(128 + cp % 64))\0A    } else if cp < 65536 {\0A        b.push(u8(224 + cp / 4096))\0A        b.push(u8(128 + (cp / 64) % 64))\0A        b.push(u8(128 + cp % 64))\0A    } else {\0A        b.push(u8(240 + cp / 262144))\0A        b.push(u8(128 + (cp / 4096) % 64))\0A        b.push(u8(128 + (cp / 64) % 64))\0A        b.push(u8(128 + cp % 64))\0A    }\0A    return str(b)\0A}\0A\0Afn read_hex4(ptr[Reader] r) -> int! {\0A    n := 0\0A    for k in 0..4 {\0A        if r.i >= r.src.len || hex_value(r.src[r.i]) < 0 {\0A            return error(unexpected(r, \22a hexadecimal digit\22))\0A        }\0A        n = n * 16 + hex_value(r.src[r.i])\0A        r.i += 1\0A    }\0A    return n\0A}\0A\0Afn read_string(ptr[Reader] r) -> str! {\0A    r.i += 1                    // the opening quote\0A    []str parts\0A    start := r.i\0A    while true {\0A        if r.i >= r.src.len {\0A            return error(\22json: a text is never closed (\22 + where(r) + \22)\22)\0A        }\0A        c := r.src[r.i]\0A        if c == '\22' {\0A            parts.push(r.src.sub(start, r.i))\0A            r.i += 1\0A            return parts.join(\22\22)\0A        }\0A        if int(c) < 32 {\0A            return error(\22json: a line break or control character inside a text (\22 + where(r) + \22)\22)\0A        }\0A        if c != '\5C\5C' {\0A            r.i += 1\0A            continue\0A        }\0A        parts.push(r.src.sub(start, r.i))\0A        r.i += 1\0A        e := peek(r)\0A        r.i += 1\0A        if e == 'n' {\0A            parts.push(\22\5Cn\22)\0A        } else if e == 't' {\0A            parts.push(\22\5Ct\22)\0A        } else if e == 'r' {\0A            parts.push(\22\5Cr\22)\0A        } else if e == 'b' {\0A            parts.push(utf8(8))\0A        } else if e == 'f' {\0A            parts.push(utf8(12))\0A        } else if e == '\22' || e == '\5C\5C' || e == '/' {\0A            parts.push(str(e))\0A        } else if e == 'u' {\0A            cp := try read_hex4(r)\0A            // a pair of \F0\9F\98\80 stands for one character above U+FFFF\0A            if cp >= 55296 && cp < 56320 && comes(r, \22\5C\5Cu\22) {\0A                r.i += 2\0A                low := try read_hex4(r)\0A                cp = 65536 + (cp - 55296) * 1024 + (low - 56320)\0A            }\0A            parts.push(utf8(cp))\0A        } else {\0A            return error(\22json: unknown escape \5C\5C\22 + str(e) + \22 in a text (\22 + where(r) + \22)\22)\0A        }\0A        start = r.i\0A    }\0A}\0A\0Afn read_number(ptr[Reader] r) -> Json! {\0A    start := r.i\0A    if peek(r) == '-' {\0A        r.i += 1\0A    }\0A    while r.i < r.src.len && ((r.src[r.i] >= '0' && r.src[r.i] <= '9') || r.src[r.i] == '.' || r.src[r.i] == 'e' || r.src[r.i] == 'E' || r.src[r.i] == '+' || r.src[r.i] == '-') {\0A        r.i += 1\0A    }\0A    n := float(r.src.sub(start, r.i)) or {\0A        r.i = start\0A        return error(unexpected(r, \22a number\22))\0A    }\0A    return new_number(n)\0A}\0A\0Afn read_value(ptr[Reader] r) -> Json! {\0A    skip_space(r)\0A    c := peek(r)\0A    if r.i >= r.src.len {\0A        return error(unexpected(r, \22a value\22))\0A    }\0A    if c == '{' {\0A        obj := new_object()\0A        r.i += 1\0A        skip_space(r)\0A        if peek(r) == '}' {\0A            r.i += 1\0A            return obj\0A        }\0A        while true {\0A            skip_space(r)\0A            if peek(r) != '\22' {\0A                return error(unexpected(r, \22a key in quotes\22))\0A            }\0A            key := try read_string(r)\0A            skip_space(r)\0A            if peek(r) != ':' {\0A                return error(unexpected(r, \22':'\22))\0A            }\0A            r.i += 1\0A            v := try read_value(r)\0A            obj.set(key, v)\0A            skip_space(r)\0A            if peek(r) == ',' {\0A                r.i += 1\0A                continue\0A            }\0A            if peek(r) == '}' {\0A                r.i += 1\0A                return obj\0A            }\0A            return error(unexpected(r, \22',' or '}'\22))\0A        }\0A    }\0A    if c == '[' {\0A        list := new_list()\0A        r.i += 1\0A        skip_space(r)\0A        if peek(r) == ']' {\0A            r.i += 1\0A            return list\0A        }\0A        while true {\0A            v := try read_value(r)\0A            list.push(v)\0A            skip_space(r)\0A            if peek(r) == ',' {\0A                r.i += 1\0A                continue\0A            }\0A            if peek(r) == ']' {\0A                r.i += 1\0A                return list\0A            }\0A            return error(unexpected(r, \22',' or ']'\22))\0A        }\0A    }\0A    if c == '\22' {\0A        s := try read_string(r)\0A        return new_text(s)\0A    }\0A    if c == 't' {\0A        try expect_word(r, \22true\22)\0A        return new_bool(true)\0A    }\0A    if c == 'f' {\0A        try expect_word(r, \22false\22)\0A        return new_bool(false)\0A    }\0A    if c == 'n' {\0A        try expect_word(r, \22null\22)\0A        return new_null()\0A    }\0A    if c == '-' || (c >= '0' && c <= '9') {\0A        return try read_number(r)\0A    }\0A    return error(unexpected(r, \22a value\22))\0A}\0A\0A// the JSON in `text`; an error with the line and column where it went wrong\0Afn parse(str text) -> Json! {\0A    r := Reader(src: text)\0A    v := try read_value(addr(r))\0A    skip_space(addr(r))\0A    if r.i < r.src.len {\0A        return error(unexpected(addr(r), \22the end of the text\22))\0A    }\0A    return v\0A}\0A\00"
@.str.7331 = private unnamed_addr constant [2847 x i8] c"// Paths, as text. Elements are separated by \22/\22.\0A//\0A//   import path\0A//   path.join(\22a\22, \22b.txt\22)        a/b.txt\0A//   path.base(\22/tmp/x/a.tar.gz\22)   a.tar.gz       path.stem(...)  a.tar       path.ext(...)  .gz\0A//   path.dir(\22/tmp/x/a.txt\22)       /tmp/x\0A//   path.clean(\22a//b/../c/./d\22)    a/c/d\0A\0A// a and b with one separator between; an absolute b replaces a\0Afn join(str a, str b) -> str {\0A    if a.len == 0 {\0A        return b\0A    }\0A    if b.len == 0 {\0A        return a\0A    }\0A    if b[0] == '/' {\0A        return b\0A    }\0A    if a[a.len - 1] == '/' {\0A        return a + b\0A    }\0A    return a + \22/\22 + b\0A}\0A\0Afn is_abs(str p) -> bool {\0A    return p.len > 0 && p[0] == '/'\0A}\0A\0A// the last element: \22a/b.txt\22 -> \22b.txt\22, \22a/b/\22 -> \22b\22, \22\22 -> \22.\22, \22/\22 -> \22/\22\0Afn base(str p) -> str {\0A    if p.len == 0 {\0A        return \22.\22\0A    }\0A    end := p.len\0A    while end > 1 && p[end - 1] == '/' {\0A        end -= 1\0A    }\0A    if end == 1 && p[0] == '/' {\0A        return \22/\22\0A    }\0A    start := end\0A    while start > 0 && p[start - 1] != '/' {\0A        start -= 1\0A    }\0A    return p.sub(start, end)\0A}\0A\0A// everything before the last element: \22a/b.txt\22 -> \22a\22, \22b.txt\22 -> \22.\22, \22/b\22 -> \22/\22\0Afn dir(str p) -> str {\0A    end := p.len\0A    while end > 1 && p[end - 1] == '/' {\0A        end -= 1\0A    }\0A    i := end\0A    while i > 0 && p[i - 1] != '/' {\0A        i -= 1\0A    }\0A    if i == 0 {\0A        return \22.\22\0A    }\0A    while i > 1 && p[i - 1] == '/' {\0A        i -= 1\0A    }\0A    return p.sub(0, i)\0A}\0A\0A// the part of the last element from its last dot: \22a.tar.gz\22 -> \22.gz\22; \22\22 when there is none\0Afn ext(str p) -> str {\0A    b := base(p)\0A    i := b.len\0A    while i > 0 && b[i - 1] != '.' {\0A        i -= 1\0A    }\0A    if i <= 1 {                 // no dot, or a name that only starts with one (.bashrc)\0A        return \22\22\0A    }\0A    return b.sub(i - 1, b.len)\0A}\0A\0A// the last element without its extension\0Afn stem(str p) -> str {\0A    b := base(p)\0A    e := ext(p)\0A    return b.sub(0, b.len - e.len)\0A}\0A\0A// the elements of a path: \22/a/b/c\22 -> [\22a\22, \22b\22, \22c\22]\0Afn parts(str p) -> []str {\0A    []str out\0A    for piece in p.split(\22/\22) {\0A        if piece.len > 0 {\0A            out.push(piece)\0A        }\0A    }\0A    return out\0A}\0A\0A// the shortest path with the same meaning: no \22//\22, no \22.\22, and \22..\22 resolved where it can be\0Afn clean(str p) -> str {\0A    if p.len == 0 {\0A        return \22.\22\0A    }\0A    abs := is_abs(p)\0A    []str out\0A    for piece in parts(p) {\0A        if piece == \22.\22 {\0A            continue\0A        }\0A        if piece == \22..\22 {\0A            if out.len > 0 && out[out.len - 1] != \22..\22 {\0A                out.pop()\0A            } else if !abs {\0A                out.push(\22..\22)\0A            }\0A            continue\0A        }\0A        out.push(piece)\0A    }\0A    joined := out.join(\22/\22)\0A    if abs {\0A        return \22/\22 + joined\0A    }\0A    if joined.len == 0 {\0A        return \22.\22\0A    }\0A    return joined\0A}\0A\00"
@.str.7332 = private unnamed_addr constant [1407 x i8] c"// Programs: run a command, read what it printed, look at the environment.\0A//\0A//   import proc\0A//   code := proc.run(\22make\22)                  the exit code; what the command prints goes to the screen\0A//   text := try proc.output(\22git describe\22)   what the command printed; an error if it failed\0A//   proc.env(\22HOME\22, \22/\22)                     an environment variable, or the second value if it is not set\0Aimport \22stdlib.h\22\0Aimport \22unistd.h\22\0Aimport \22time.h\22\0A\0A// run a command; its output goes to the screen. Gives its exit code.\0Afn run(str command) -> int {\0A    return shell(command)\0A}\0A\0A// run a command and give what it printed. Fails, with its output as the message, if it exits with an error.\0Afn output(str command) -> str! {\0A    tmp := \22/tmp/finch_out_\22 + str(getpid()) + \22_\22 + str(int(time(null)))\0A    code := shell(\22(\22 + command + \22) > '\22 + tmp + \22' 2>&1\22)\0A    text := read_file(tmp) or \22\22\0A    delete_file(tmp)\0A    if code != 0 {\0A        return error(\22'\22 + command + \22' exited with code \22 + str(code) + \22: \22 + text.trim())\0A    }\0A    return text\0A}\0A\0Afn env(str name, str fallback) -> str {\0A    v := getenv(name)\0A    if v.len == 0 {\0A        return fallback\0A    }\0A    return v\0A}\0A\0Afn pid() -> int {\0A    return int(getpid())\0A}\0A\0A// the folder the program is running in\0Afn cwd() -> str {\0A    []char buf\0A    for i in 0..4096 {\0A        buf.push(char(0))\0A    }\0A    getcwd(buf.ptr, 4096)\0A    return str(buf.ptr)\0A}\0A\00"
@.str.7333 = private unnamed_addr constant [996 x i8] c"// Programs, for Windows. The same functions as proc.fch (that file is for Linux and macOS).\0Aimport \22stdlib.h\22\0Aimport \22process.h\22\0Aimport \22direct.h\22\0Aimport \22time.h\22\0A\0Afn run(str command) -> int {\0A    return shell(command)\0A}\0A\0Afn output(str command) -> str! {\0A    tmp := proc_env(\22TEMP\22, \22.\22) + \22\5C\5Cfinch_out_\22 + str(getpid()) + \22_\22 + str(int(time(null)))\0A    code := shell(command + \22 > \5C\22\22 + tmp + \22\5C\22 2>&1\22)\0A    text := read_file(tmp) or \22\22\0A    delete_file(tmp)\0A    if code != 0 {\0A        return error(\22'\22 + command + \22' exited with code \22 + str(code) + \22: \22 + text.trim())\0A    }\0A    return text\0A}\0A\0Afn proc_env(str name, str fallback) -> str {\0A    v := getenv(name)\0A    if v.len == 0 {\0A        return fallback\0A    }\0A    return v\0A}\0A\0Afn env(str name, str fallback) -> str {\0A    return proc_env(name, fallback)\0A}\0A\0Afn pid() -> int {\0A    return int(getpid())\0A}\0A\0Afn cwd() -> str {\0A    []char buf\0A    for i in 0..4096 {\0A        buf.push(char(0))\0A    }\0A    getcwd(buf.ptr, 4096)\0A    return str(buf.ptr)\0A}\0A\00"
@.str.7334 = private unnamed_addr constant [2540 x i8] c"// Time: the clock, sleeping, and dates.\0A//\0A//   import time\0A//   start := time.millis()          milliseconds from a clock that only goes forward (to measure with)\0A//   time.sleep(250)                 wait a quarter of a second\0A//   time.now()                      seconds since 1970-01-01 00:00 UTC\0A//   d := time.date(time.now())      the parts: d.year, d.month, d.day, d.hour, d.minute, d.second\0A//   time.format(time.now(), \22%Y-%m-%d %H:%M\22)      as text, in the computer's time zone\0Aimport \22time.h\22\0A\0Astruct Date {\0A    int year\0A    int month       // 1 to 12\0A    int day         // 1 to 31\0A    int hour\0A    int minute\0A    int second\0A    int weekday     // 0 is Sunday\0A    int yearday     // 1 to 366\0A}\0A\0A// seconds since 1970-01-01 00:00 UTC\0Afn now() -> int {\0A    return int(time(null))\0A}\0A\0A// milliseconds on a clock that only goes forward: for measuring how long something took\0Afn millis() -> int {\0A    timespec ts\0A    clock_gettime(CLOCK_MONOTONIC, addr(ts))\0A    return int(ts.tv_sec) * 1000 + int(ts.tv_nsec) / 1000000\0A}\0A\0Afn sleep(int ms) {\0A    timespec ts\0A    ts.tv_sec = ms / 1000\0A    ts.tv_nsec = (ms % 1000) * 1000000\0A    nanosleep(addr(ts), null)\0A}\0A\0Afn parts(tm t) -> Date {\0A    return Date(year: int(t.tm_year) + 1900, month: int(t.tm_mon) + 1, day: int(t.tm_mday), hour: int(t.tm_hour),\0A                minute: int(t.tm_min), second: int(t.tm_sec), weekday: int(t.tm_wday), yearday: int(t.tm_yday) + 1)\0A}\0A\0A// the date and time of a moment, in UTC\0Afn date(int unix) -> Date {\0A    tm t\0A    i64 stamp = unix\0A    gmtime_r(addr(stamp), addr(t))\0A    return parts(t)\0A}\0A\0A// the date and time of a moment, in the computer's time zone\0Afn local(int unix) -> Date {\0A    tm t\0A    i64 stamp = unix\0A    localtime_r(addr(stamp), addr(t))\0A    return parts(t)\0A}\0A\0A// a moment as text, in the computer's time zone: %Y year, %m month, %d day, %H hour, %M minute, %S second\0A// (the rest of C's strftime works too: %A weekday name, %B month name, ...)\0Afn format(int unix, str pattern) -> str {\0A    tm t\0A    i64 stamp = unix\0A    localtime_r(addr(stamp), addr(t))\0A    []char buf\0A    for i in 0..256 {\0A        buf.push(char(0))\0A    }\0A    strftime(buf.ptr, 256, pattern, addr(t))\0A    return str(buf.ptr)\0A}\0A\0A// the number of days in a month (month is 1 to 12)\0Afn days_in_month(int year, int month) -> int {\0A    if month == 2 {\0A        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) {\0A            return 29\0A        }\0A        return 28\0A    }\0A    if month == 4 || month == 6 || month == 9 || month == 11 {\0A        return 30\0A    }\0A    return 31\0A}\0A\00"
