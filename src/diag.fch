// How the compiler talks to people: errors and warnings with the line of code they are about, a mark under the
// exact spot, the hint on a line of its own, and colours in a terminal.
//
//   game.fch:3:13: error: 'y' must be i32, but this is int
//      |
//    3 |     i32 y = x
//      |             ^
//      = help: use i32(...) to convert
//
// The first line stays "path:line:col: error: message", so terminals and editors can jump to it. Colours only go to a
// terminal (never a pipe, a file, a test or an editor); NO_COLOR turns them off, FINCH_COLOR=always|never decides.
import "stdio.h"
import "stdlib.h"
import host

fn colors() -> bool {
    force := getenv("FINCH_COLOR")
    if force == "always" {
        return true
    }
    if force == "never" {
        return false
    }
    if getenv("NO_COLOR").len > 0 || getenv("TERM") == "dumb" {
        return false
    }
    return host.isTerminal(2)
}

// text in a colour: "1" bold, "2" dim, "31" red, "32" green, "33" yellow, "34" blue, "36" cyan ("1;31": both)
fn paint(bool on, str code, str text) -> str {
    if !on || text.len == 0 {
        return text
    }
    esc := str(char(27))
    return esc + "[" + code + "m" + text + esc + "[0m"
}

fn say(str text) {
    fputs(text + "\n", stderr)
}

// "must be i32, but this is int (use i32(...) to convert)" -> the message and "use i32(...) to convert".
// Only a last ( ... ) that follows a space and closes the message is a hint; asm("nop") is not.
fn splitHelp(str msg) -> []str {
    if !msg.ends_with(")") {
        return [msg, ""]
    }
    depth := 0
    i := msg.len - 1
    while i >= 0 {
        if msg[i] == ')' {
            depth += 1
        } else if msg[i] == '(' {
            depth -= 1
            if depth == 0 {
                break
            }
        }
        i -= 1
    }
    if i <= 0 || msg[i - 1] != ' ' {
        return [msg, ""]
    }
    inner := msg.sub(i + 1, msg.len - 1).trim()
    if inner.len == 0 {
        return [msg, ""]
    }
    return [msg.sub(0, i - 1).trim(), inner]
}

fn isWordChar(char c) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// how many columns of the screen the start of a line takes (a tab is 4, a UTF-8 letter is one)
fn width(str s) -> int {
    n := 0
    for c in s {
        b := int(c)
        if b < 0 {
            b += 256
        }
        if c == '\t' {
            n += 4
        } else if b < 128 || b >= 192 {
            n += 1
        }
    }
    return n
}

// columns count letters (a UTF-8 letter is one, as the lexer counts them): where column `col` starts, in bytes
fn byteOfColumn(str line, int col) -> int {
    letters := 0
    i := 0
    while i < line.len {
        b := int(line[i])
        if b < 0 {
            b += 256
        }
        if b < 128 || b >= 192 {
            letters += 1
            if letters == col {
                return i
            }
        }
        i += 1
    }
    return line.len
}

// how long the mark under the spot is: a whole name, number or "text", or one character
fn spanAt(str line, int at) -> int {
    if at >= line.len {
        return 1
    }
    c := line[at]
    if c == '"' {
        end := at + 1
        while end < line.len && line[end] != '"' {
            if line[end] == '\\' {
                end += 1
            }
            end += 1
        }
        if end < line.len {
            return width(line.sub(at, end + 1))
        }
        return 1
    }
    if !isWordChar(c) {
        return 1
    }
    end := at
    while end < line.len && isWordChar(line[end]) {
        end += 1
    }
    return end - at
}

fn lineOf(str path, int line) -> str {
    if line < 1 {
        return ""
    }
    text := read_file(path) or ""
    lines := text.split("\n")
    if line > lines.len {
        return ""
    }
    return lines[line - 1].replace("\r", "")
}

// The few lines under the first one: the code, the mark, the hint and a note.
fn show(bool on, str markColor, str path, int line, int col, str help, str note) {
    code := lineOf(path, line)
    num := str(line)
    pad := " ".repeat(num.len)
    bar := paint(on, "1;34", "|")
    if code.trim().len > 0 {
        at := byteOfColumn(code, col)
        say(" " + pad + " " + bar)
        say(" " + paint(on, "1;34", num) + " " + bar + " " + code.replace("\t", "    "))
        say(" " + pad + " " + bar + " " + " ".repeat(width(code.sub(0, at))) + paint(on, markColor, "^".repeat(spanAt(code, at))))
    }
    if help.len > 0 {
        say(" " + pad + " " + paint(on, "1;34", "=") + " " + paint(on, "1;36", "help:") + " " + help)
    }
    if note.len > 0 {
        say(" " + pad + " " + paint(on, "1;34", "=") + " " + paint(on, "1", "note:") + " " + note)
    }
}

fn header(bool on, str path, int line, int col, str what, str color, str msg) -> str {
    where := path + ":" + str(line)
    if col > 0 {
        where += ":" + str(col)
    }
    return paint(on, "1", where + ":") + " " + paint(on, color, what + ":") + " " + paint(on, "1", msg)
}

// Something that stops the build. `note` is said after it (like "while building max[int]").
fn errorAt(str path, int line, int col, str msg, str note) {
    on := colors()
    parts := splitHelp(msg)
    say(header(on, path, line, col, "error", "1;31", parts[0]))
    show(on, "1;31", path, line, col, parts[1], note)
    if on {
        say("")
        say(paint(on, "2", quip(msg.len + line)))
    }
}

// Something worth a look; the program is still built.
fn warningAt(str path, int line, int col, str msg) {
    on := colors()
    parts := splitHelp(msg)
    say(header(on, path, line, col, "warning", "1;33", parts[0]))
    show(on, "1;33", path, line, col, parts[1], "")
}

// An error with no place in the code (a missing file, a bad option).
fn problem(str msg) {
    on := colors()
    say(paint(on, "1;31", "error:") + " " + paint(on, "1", msg))
}

fn notice(str msg) {
    on := colors()
    say(paint(on, "1;33", "warning:") + " " + msg)
}

// A line said under an error in a terminal, to keep it human.
fn quip(int seed) -> str {
    lines := [
        "The finch is waiting on its branch. One fix and it flies.",
        "Not airborne yet. Every bird misses its first jump.",
        "Nothing was built, and nothing is broken either. Fix it and try again.",
        "Small bird, big patience. Fix it and run it again.",
        "The compiler read carefully so your program doesn't have to crash.",
        "One feather out of place. Smooth it and try again.",
        "Even the best nests get rebuilt. You've got this.",
    ]
    if seed < 0 {
        seed = -seed
    }
    return lines[seed % lines.len]
}

// "    Built hello in 0.42s  (optimized, x86-64 Linux)" after a build that worked, in a terminal only.
fn status(str verb, str what, str when, str detail) {
    on := colors()
    if !on {
        return
    }
    line := paint(on, "1;32", padLeft(verb, 9, " ")) + " " + paint(on, "1", what)
    if when.len > 0 {
        line += " " + when
    }
    if detail.len > 0 {
        line += paint(on, "2", "  (" + detail + ")")
    }
    say(line)
}

fn seconds(int ms) -> str {
    return str(ms / 1000) + "." + padLeft(str((ms % 1000) / 10), 2, "0") + "s"
}

fn padLeft(str s, int n, str fill) -> str {
    if s.len >= n {
        return s
    }
    return fill.repeat(n - s.len) + s
}

// A message made elsewhere (the linker, a C header): said as it is, with its "error:" and "warning:" in colour.
fn passOn(str text) {
    on := colors()
    if on {
        text = text.replace("error:", paint(on, "1;31", "error:")).replace("warning:", paint(on, "1;33", "warning:"))
    }
    say(text.trim())
}
