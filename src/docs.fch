// One description of every built-in function and method, shared by the compiler (the index the language
// server asks for) and the language server (hover, completion, signature help).

struct Doc {
    str name
    str signature
    str text
}

fn doc(str name, str signature, str text) -> Doc {
    return Doc(name: name, signature: signature, text: text)
}

fn builtins() -> []Doc {
    return [
        doc("print", "print(a, b, ...)", "Prints the values separated by spaces, then a new line. Works with every type."),
        doc("input", "input(str question = \"\") -> str", "Shows the question and reads one line typed by the user, without the newline."),
        doc("read_file", "read_file(str path) -> str", "The whole file as text. Stops the program if it can't be read, unless handled: read_file(p) or { ... }, try read_file(p)."),
        doc("write_file", "write_file(str path, str text) -> bool", "Writes (replaces) the file. true if it worked; with or / try, the reason it didn't."),
        doc("file_exists", "file_exists(str path) -> bool", "Is there a file at this path?"),
        doc("delete_file", "delete_file(str path) -> bool", "Deletes the file. true if it worked; with or / try, the reason it didn't."),
        doc("error", "error(str message)", "The failure a fallible function returns: return error(\"...\"). The caller handles it with or / try."),
        doc("shell", "shell(str command) -> int", "Runs a command in the system's shell and gives back its exit code."),
        doc("exit", "exit(int code)", "Ends the program right away with this exit code (it also ends an or { } block)."),
        doc("min", "min(a, b, ...) -> number", "The smallest of the numbers, in the type they all fit."),
        doc("max", "max(a, b, ...) -> number", "The biggest of the numbers, in the type they all fit."),
        doc("abs", "abs(x) -> number", "x without its minus sign (any number type)."),
        doc("clamp", "clamp(x, lo, hi) -> number", "x, but at least lo and at most hi."),
        doc("asm", "asm(str code, values...)", "Processor instructions written in the code (Intel syntax on x86). {x} in the text is the variable x in a register; mut x means the instructions change it; reg: x puts x in that exact register: asm(\"cpuid\", eax: mut a)."),
        doc("cpu_has", "cpu_has(str feature) -> bool", "Does the processor running the program have this feature (\"avx2\", \"avx512f\", \"avxvnni\", \"dotprod\", \"i8mm\" ...)? Check before calling a @cpu(...) function."),
        doc("concat", "concat(V a, V b) -> V2", "One vector with a's lanes, then b's (twice as many)."),
        doc("select", "select(mask, a, b) -> V", "Lane by lane: a where the mask is true, b where it is false. The mask comes from comparing vectors (v > 0.0)."),
        doc("fma", "fma(a, b, c) -> float", "a * b + c with one rounding, always (numbers or vectors). a * b + c written out is never fused: two roundings."),
        doc("muladd", "muladd(a, b, c) -> float", "a * b + c the fastest way here: one fused instruction where the processor has one, else a multiply and an add."),
        doc("f32_bits", "f32_bits(f32 x) -> u32", "The bits of x, unchanged (also f32xN -> u32xN). f64_bits gives a u64."),
        doc("f32_from_bits", "f32_from_bits(u32 bits) -> f32", "The f32 with these bits (also u32xN -> f32xN). f64_from_bits takes a u64."),
        doc("f64_bits", "f64_bits(float x) -> u64", "The bits of x, unchanged (also f64xN -> u64xN)."),
        doc("f64_from_bits", "f64_from_bits(u64 bits) -> float", "The float with these bits (also u64xN -> f64xN)."),
        doc("f16_to_f32", "f16_to_f32(u16 half) -> f32", "A half-precision number, kept in a u16, as an f32 (also u16xN -> f32xN)."),
        doc("f32_to_f16", "f32_to_f16(f32 x) -> u16", "x as a half-precision number in a u16, rounded to the nearest (also f32xN -> u16xN)."),
        doc("bf16_to_f32", "bf16_to_f32(u16 b) -> f32", "A bfloat16, kept in a u16, as an f32 (also u16xN -> f32xN)."),
        doc("f32_to_bf16", "f32_to_bf16(f32 x) -> u16", "x as a bfloat16 in a u16, rounded to the nearest, ties to even (also f32xN -> u16xN)."),
        doc("atomic_add", "atomic_add(ptr[int] p, n) -> int", "Adds n to the number at p in one step other threads can't split; gives back what was there before."),
        doc("atomic_sub", "atomic_sub(ptr[int] p, n) -> int", "Takes n from the number at p in one step; gives back what was there before."),
        doc("atomic_load", "atomic_load(ptr[int] p) -> int", "Reads the number at p, as another thread last wrote it."),
        doc("atomic_store", "atomic_store(ptr[int] p, n)", "Writes n to p so other threads see it whole."),
        doc("atomic_swap", "atomic_swap(ptr[int] p, n) -> int", "Puts n at p and gives back what was there, in one step."),
        doc("atomic_cas", "atomic_cas(ptr[int] p, old, new) -> bool", "Puts new at p only if old is there (compare and swap); true if it did."),
        doc("addr", "addr(x) -> ptr[T]", "A pointer to a variable, field or element. addr(function) gives C a callback."),
        doc("new", "new(value) -> ptr[T]", "Puts a copy of the value on the heap. Give it back with free(...)."),
        doc("free", "free(ptr p)", "Gives back memory from new(...) (or from C), freeing what the value owns."),
        doc("str", "str(x) -> str", "Turns a number, bool, char, []u8 or C char pointer into text. str(x, 2): a number with 2 digits after the point."),
        doc("int", "int(x) -> int", "Converts to a whole number: cuts off fractions, parses text (stops the program if it isn't a number, unless handled: int(s) or 0)."),
        doc("float", "float(x) -> float", "Converts to a decimal number; parses text (int(s) or 0.0 handles bad text)."),
        doc("char", "char(int n) -> char", "The character with this code."),
        doc("bool", "bool(int n) -> bool", "true for any number but 0."),
        doc("ptr", "ptr(x) -> ptr", "An untyped pointer: from a typed pointer, or from a number (an address or offset for C)."),
        doc("f32x8", "f32x8(x) / f32x8(a, b, ...) / f32x8(list, i) / f32x8(v)", "A vector: 8 f32 side by side, worked on all at once (SIMD). Every lane x; one value per lane; 8 numbers from list[i]; or another 8-lane vector converted. The same goes for i8x16, i32x8, f64x4 and the rest.")
    ]
}

fn arrayMethods() -> []Doc {
    return [
        doc("len", ".len -> int", "The number of elements."),
        doc("ptr", ".ptr -> ptr[T]", "The address of the first element, for C."),
        doc("push", "push(T x)", "Adds x at the end."),
        doc("pop", "pop() -> T", "Removes the last element and gives it back."),
        doc("insert", "insert(int i, T x)", "Puts x at position i, moving the rest."),
        doc("remove", "remove(int i) -> T", "Removes position i and gives it back."),
        doc("clear", "clear()", "Removes everything."),
        doc("resize", "resize(int n)", "Makes the array n long; new elements are zero."),
        doc("find", "find(T x) -> int", "The index of x, or -1."),
        doc("contains", "contains(T x) -> bool", "Is x in the array?"),
        doc("sort", "sort()", "Sorts in place (numbers, chars, str)."),
        doc("sort_by", "sort_by(fn(T a, T b) -> bool before)", "Sorts in place by your rule: before(a, b) says whether a goes first. Equal ones keep their order: people.sort_by(fn(a, b) { return a.age < b.age })."),
        doc("filter", "filter(fn(T x) -> bool keep) -> []T", "A new array with the elements keep(x) says yes to: nums.filter(fn(n) { return n > 0 })."),
        doc("map", "map(fn(T x) -> U change) -> []U", "A new array with change(x) of every element: names.map(fn(str s) -> int { return s.len })."),
        doc("any", "any(fn(T x) -> bool test) -> bool", "Is test(x) true for at least one element? Stops at the first."),
        doc("all", "all(fn(T x) -> bool test) -> bool", "Is test(x) true for every element? Stops at the first that isn't."),
        doc("reverse", "reverse()", "Reverses in place."),
        doc("slice", "slice(int start, int end) -> []T", "A new array with the elements start to end-1."),
        doc("join", "join(str sep) -> str", "For []str: one text with sep between the parts.")
    ]
}

fn strMethods() -> []Doc {
    return [
        doc("len", ".len -> int", "The number of bytes."),
        doc("ptr", ".ptr -> ptr[char]", "The address of the text, for C (valid while the str lives)."),
        doc("sub", "sub(int start, int end) -> str", "The part from start to end-1."),
        doc("find", "find(str t) -> int", "Where t starts, or -1."),
        doc("contains", "contains(str t) -> bool", "Does the text contain t?"),
        doc("starts_with", "starts_with(str t) -> bool", "Does the text start with t?"),
        doc("ends_with", "ends_with(str t) -> bool", "Does the text end with t?"),
        doc("split", "split(str sep) -> []str", "The parts between each sep; split(\"\") gives single characters."),
        doc("trim", "trim() -> str", "Without spaces and newlines at both ends."),
        doc("upper", "upper() -> str", "With a-z changed to A-Z."),
        doc("lower", "lower() -> str", "With A-Z changed to a-z."),
        doc("replace", "replace(str from, str to) -> str", "Every from replaced by to."),
        doc("repeat", "repeat(int n) -> str", "The text n times."),
        doc("bytes", "bytes() -> []u8", "The bytes of the text.")
    ]
}

fn mapMethods() -> []Doc {
    return [
        doc("len", ".len -> int", "The number of keys."),
        doc("has", "has(K key) -> bool", "Is the key in the map?"),
        doc("get", "get(K key, V default) -> V", "The value for key, or default if the key isn't there."),
        doc("remove", "remove(K key) -> bool", "Removes the key and its value; true if it was there."),
        doc("clear", "clear()", "Removes everything."),
        doc("keys", "keys() -> []K", "The keys, in the order they were added."),
        doc("values", "values() -> []V", "The values, in the order their keys were added.")
    ]
}

fn vecMethods() -> []Doc {
    return [
        doc("len", ".len -> int", "The number of lanes."),
        doc("sum", "sum() -> T", "All the lanes added up (floats: in whatever order is fastest)."),
        doc("min", "min() -> T", "The smallest lane."),
        doc("max", "max() -> T", "The biggest lane."),
        doc("dot", "dot(V w) -> T", "Lane times lane, added up: (v * w).sum()."),
        doc("sqrt", "sqrt() -> V", "The square root of every lane (f32/f64 lanes)."),
        doc("floor", "floor() -> V", "Every lane rounded down (f32/f64 lanes)."),
        doc("ceil", "ceil() -> V", "Every lane rounded up (f32/f64 lanes)."),
        doc("round", "round() -> V", "Every lane rounded to the nearest whole number, halves away from 0 (f32/f64 lanes)."),
        doc("abs", "abs() -> V", "Every lane without its minus sign."),
        doc("fma", "fma(V b, V c) -> V", "v * b + c with one rounding, always (f32/f64 lanes). One instruction with FMA hardware, slower without."),
        doc("muladd", "muladd(V b, V c) -> V", "v * b + c the fastest way here: fused into one instruction where the processor can (f32/f64 lanes)."),
        doc("store", "store([]T list, int i)", "Writes the lanes into list[i], list[i+1], ... (or through a ptr[T])."),
        doc("store_part", "store_part([]T list, int i)", "Writes the lanes that fit in the list (for its last, shorter piece)."),
        doc("shuffle", "shuffle(int a, int b, ...) -> V", "A vector of the lanes with these numbers (written in the code): v.shuffle(3, 2, 1, 0) reverses an f32x4."),
        doc("lo", "lo() -> V", "The lower half of the lanes."),
        doc("hi", "hi() -> V", "The upper half of the lanes."),
        doc("lookup", "lookup(I indices) -> V", "For every lane of indices: this vector's lane (index % len). A byte-table lookup (pshufb, tbl)."),
        doc("dot_add", "dot_add(a, b) -> i32xN", "On an i32xN of sums: each lane gains the sum of 4 byte products of a and b (u8/i8, 4N lanes). One instruction with AVX-VNNI, AVX-512 VNNI or ARM's dot product."),
        doc("any", "any() -> bool", "A mask: is any lane true?"),
        doc("all", "all() -> bool", "A mask: are all lanes true?"),
        doc("count", "count() -> int", "A mask: how many lanes are true.")
    ]
}

fn keywords() -> []str {
    return ["fn", "return", "if", "else", "while", "for", "in", "break", "continue", "true", "false", "null", "import",
            "link", "struct", "enum", "match", "export", "defer", "or", "try", "self", "const", "mut"]
}

fn typeNames() -> []str {
    return ["int", "float", "bool", "char", "str", "ptr", "map", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64",
            "f32x4", "f32x8", "f32x16", "f64x2", "f64x4", "f64x8", "i8x16", "i8x32", "i8x64", "u8x16", "u8x32", "u8x64",
            "i16x8", "i16x16", "i16x32", "i32x4", "i32x8", "i32x16", "u32x4", "u32x8", "u32x16", "i64x2", "i64x4", "i64x8"]
}

// the entry called `name`, or an empty Doc
fn find([]Doc list, str name) -> Doc {
    for d in list {
        if d.name == name {
            return d
        }
    }
    return Doc()
}

// the text of a hover for a documented built-in
fn hover(Doc d) -> str {
    return "```finch\n" + d.signature + "\n```\n" + d.text
}
