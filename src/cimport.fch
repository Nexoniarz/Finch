// C headers, read through libclang, written in Finch.
//
// What `import "stdio.h"` teaches the compiler: the C functions, the constants (enum values and
// plain #define numbers), the extern variables (stdout) and the structs. It calls libclang's C API
// through Finch's own C import -- so to compile this file, the compiler reads libclang's headers
// with this very code.
//
// C structs by value appear in types as the named type `module "C"`.
import ast
import host
import "clang-c/Index.h"
link "clang"

struct CFunc {
    str name
    str header          // the import it came from
    ast.Type ret
    []ast.Type params
    bool variadic
    str shown           // the name the program uses, when it isn't the C name (a C++ function's wrapper)
    bool inline         // static inline in the header: called through a pointer a small C file keeps (finch_inl_name)
    str unsupported     // non-empty: why Finch can't call it (yet)
}

struct CConst {         // enum values and #define constants
    bool isFloat
    int i
    float f
    str text            // a float as written, so no digits are lost: 3.14159265358979323846
    bool isStr          // #define NAME "text"
    str s
    str structName      // #define RAYWHITE (Color){ 245, 245, 245, 255 }: the struct, and its fields in order
    []str fields        // each as a Finch literal: 245, 0.5
    []bool fieldFloat
}

// what visitMacroVar looks for inside (Color){ ... }
struct InitFind {
    bool found
    CXCursor list
    bool ok
    []str fields
    []bool floats
}

struct CField {
    str name
    ast.Type ty
    int offset          // bytes
    int size
    int align
    bool hidden         // unions, bit fields, unmappable types: kept for layout only
}

struct CStruct {
    str name
    []CField fields
    int size
    int align
    str unsupported     // why it can't be used by value (pointers to it still work)
    bool hasHidden
    bool isUnion        // every field starts at byte 0
}

struct CImports {
    map[str]CFunc fns
    map[str]CConst consts
    map[str]ast.Type globals
    map[str]CStruct structs
    []str structOrder   // the order they were defined in
    map[str][]str cppNames      // C++: name in Finch (ImGui.Begin, Window#resize, f) -> its wrappers (C functions)
    map[str]str cppSkipped      // C++: name in Finch -> why it can't be called
    []str cppFiles              // C++: the wrapper files to build and link
    map[str]bool cppOpaque      // C++: classes used only through pointers
}

// A header to read: the path as written, and where it was written, for error messages.
struct Header {
    str path
    str where
}

// Where a C type is used decides how `char *` looks in Finch: in function signatures it is a
// `str`; inside structs, globals and behind pointers it stays a raw `ptr[char]`.
struct Mapped {
    ast.Type ty
    str why
    bool ok
}

struct Importer {
    CImports out
    ptr tu
    str header
    map[str]str recordNames     // record USR -> Finch name (a typedef name wins)
    map[str]bool defining       // USR -> true while its fields are being mapped
    int anon
    []str exprMacros            // #defines that are expressions: clang works out their values
}

fn text(CXString s) -> str {
    out := clang_getCString(s)
    clang_disposeString(s)
    return out
}

fn ok(ast.Type t) -> Mapped {
    return Mapped(ty: t, ok: true)
}

fn no(str why) -> Mapped {
    return Mapped(why: why, ok: false)
}

fn fixed(ast.Type elem, int count) -> ast.Type {
    t := ast.Type(kind: "fixed", count: count)
    t.elem.push(elem)
    return t
}

// ---------- the system's header folders ----------

// Ask the system C compiler where it looks for headers, so we find the same stdio.h it would.
fn systemIncludeArgs(str cc) -> []str {
    return systemIncludeArgsFor(cc, "c")
}

// where the compiler finds <stdio.h> (lang "c") or <vector> (lang "c++")
fn systemIncludeArgsFor(str cc, str lang) -> []str {
    []str dirs
    tmp := host.tempDir() + "/finch_cc_dirs_" + str(host.pid()) + ".txt"
    empty := host.tempDir() + "/finch_empty_" + str(host.pid()) + ".c"
    write_file(empty, "")
    host.run(cc + " -E -v -x " + lang + " " + host.quote(empty) + " 2> " + host.quote(tmp) + " > " + host.nullDevice())
    host.remove(empty)
    if !file_exists(tmp) {
        return dirs
    }
    inList := false
    for line in read_file(tmp).split("\n") {
        l := line.trim()
        if l.starts_with("#include <...> search starts here:") {
            inList = true
            continue
        }
        if l.starts_with("End of search list.") {
            break
        }
        if !inList || l.len == 0 {
            continue
        }
        // macOS: "/.../Frameworks (framework directory)"
        if l.ends_with(" (framework directory)") {
            dirs.push("-iframework" + l.sub(0, l.len - 22))
        } else {
            dirs.push("-isystem" + l)
        }
    }
    host.remove(tmp)
    return dirs
}

// ---------- records ----------

// The Finch name of a C record: its typedef name, its tag, or a made-up one.
fn recordName(ptr[Importer] imp, CXType t) -> str {
    decl := clang_getTypeDeclaration(t)
    usr := text(clang_getCursorUSR(decl))
    if imp.recordNames.has(usr) {
        return imp.recordNames[usr]
    }
    name := text(clang_getCursorSpelling(decl))
    if name.len == 0 || name.contains(" ") {
        imp.anon += 1
        name = "anon_struct_" + str(imp.anon)
    }
    imp.recordNames[usr] = name
    return name
}

// Fill out.structs[name] for a complete record; returns its name, or "" if it can't be one.
fn defineRecord(ptr[Importer] imp, CXType type) -> str {
    t := clang_getCanonicalType(type)
    decl := clang_getTypeDeclaration(t)
    usr := text(clang_getCursorUSR(decl))
    name := recordName(imp, t)
    if imp.out.structs.has(name) || imp.defining.has(usr) {
        return name
    }
    size := int(clang_Type_getSizeOf(t))
    if size < 0 {
        return ""           // incomplete (opaque) struct
    }
    imp.defining[usr] = true
    s := CStruct(name: name, size: size, align: int(clang_Type_getAlignOf(t)))
    if clang_getCursorKind(decl) == CXCursor_UnionDecl {
        s.unsupported = "is a C union"
        s.isUnion = true
    }
    // the fields are collected by a callback that gets the importer and the struct through one pointer
    ctx := FieldCtx(imp: imp, s: addr(s))
    clang_Type_visitFields(t, addr(visitField), addr(ctx))
    imp.defining.remove(usr)
    imp.out.structs[name] = s
    imp.out.structOrder.push(name)
    return name
}

struct FieldCtx {
    ptr[Importer] imp
    ptr[CStruct] s
}

fn visitField(CXCursor field, ptr data) -> i32 {
    ptr[FieldCtx] c = data
    f := CField(name: text(clang_getCursorSpelling(field)))
    ft := clang_getCanonicalType(clang_getCursorType(field))
    f.offset = int(clang_Cursor_getOffsetOfField(field)) / 8
    f.size = int(clang_Type_getSizeOf(ft))
    f.align = int(clang_Type_getAlignOf(ft))
    if clang_Cursor_isBitField(field) != 0 {
        c.s.unsupported = "has bit fields"
        f.hidden = true
    } else {
        if ft.kind == CXType_Record && clang_getCursorKind(clang_getTypeDeclaration(ft)) == CXCursor_UnionDecl {
            c.s.unsupported = "has a union inside"     // its fields can be used, but not passed by value
        }
        m := mapType(c.imp, ft, false, false)
        if m.ok {
            f.ty = m.ty
        } else {
            f.hidden = true
        }
    }
    if f.hidden {
        c.s.hasHidden = true
    }
    if f.name.len == 0 {
        f.hidden = true
    }
    c.s.fields.push(f)
    return CXVisit_Continue
}

// ---------- types ----------

fn sized(int size, bool signed) -> Mapped {
    if size == 1 {
        if signed {
            return ok(ast.simple("i8"))
        }
        return ok(ast.simple("u8"))
    }
    if size == 2 {
        if signed {
            return ok(ast.simple("i16"))
        }
        return ok(ast.simple("u16"))
    }
    if size == 4 {
        if signed {
            return ok(ast.simple("i32"))
        }
        return ok(ast.simple("u32"))
    }
    if size == 8 {
        if signed {
            return ok(ast.simple("int"))
        }
        return ok(ast.simple("u64"))
    }
    return no("uses a " + str(size * 8) + "-bit number")
}

// C type -> Finch type. Not ok (with a reason) if Finch can't express it.
// `signature`: a char * is a str (a function's parameters and result); anywhere else it stays a ptr[char].
// A parameter that is a plain `char *` (not const) is a buffer C writes into, and stays a ptr[char];
// only `const char *` is text going in. A result that is a char * is always text coming out.
fn mapType(ptr[Importer] imp, CXType type, bool signature, bool param) -> Mapped {
    t := clang_getCanonicalType(type)
    size := int(clang_Type_getSizeOf(t))
    k := t.kind
    if k == CXType_Void {
        return ok(ast.simple("void"))
    }
    if k == CXType_Bool {
        return ok(ast.simple("bool"))
    }
    if k == CXType_Char_S || k == CXType_Char_U {
        return ok(ast.simple("char"))
    }
    if k == CXType_SChar || k == CXType_Short || k == CXType_Int || k == CXType_Long || k == CXType_LongLong {
        return sized(size, true)
    }
    if k == CXType_UChar || k == CXType_UShort || k == CXType_UInt || k == CXType_ULong || k == CXType_ULongLong {
        return sized(size, false)
    }
    if k == CXType_Enum {
        return sized(size, true)
    }
    if k == CXType_Float {
        return ok(ast.simple("f32"))
    }
    if k == CXType_Double {
        return ok(ast.simple("float"))
    }
    if k == CXType_Pointer {
        pointee := clang_getCanonicalType(clang_getPointeeType(t))
        if (pointee.kind == CXType_Char_S || pointee.kind == CXType_Char_U) && signature {
            if !param || clang_isConstQualifiedType(pointee) != 0 {
                return ok(ast.simple("str"))    // a C string
            }
        }
        if pointee.kind == CXType_Void || pointee.kind == CXType_FunctionProto || pointee.kind == CXType_FunctionNoProto {
            return ok(ast.simple("ptr"))        // an opaque `ptr` you can pass around
        }
        if pointee.kind == CXType_Record && clang_Type_getSizeOf(pointee) < 0 {
            // a C++ class seen only from outside: a typed pointer, so its methods can be called on it
            nm := recordName(imp, pointee)
            if imp.out.cppOpaque.has(nm) {
                if !imp.out.structs.has(nm) {
                    imp.out.structs[nm] = CStruct(name: nm, size: 0, align: 1, unsupported: "is a C++ class: Finch uses it through a pointer (" + nm + ".new(...) makes one)")
                    imp.out.structOrder.push(nm)
                }
                return ok(ast.ptrTo(ast.Type(kind: "named", name: nm, module: "C")))
            }
        }
        inner := mapType(imp, pointee, false, false)
        if !inner.ok || inner.ty.kind == "void" || inner.ty.kind == "fixed" {
            return ok(ast.simple("ptr"))
        }
        return ok(ast.ptrTo(inner.ty))
    }
    if k == CXType_Record {
        name := defineRecord(imp, t)
        if name.len == 0 {
            return no("uses an incomplete C struct by value")
        }
        return ok(ast.Type(kind: "named", name: name, module: "C"))
    }
    if k == CXType_ConstantArray {
        inner := mapType(imp, clang_getArrayElementType(t), false, false)
        if !inner.ok {
            return inner
        }
        return ok(fixed(inner.ty, int(clang_getArraySize(t))))
    }
    if k == CXType_LongDouble {
        return no("uses long double")
    }
    return no("uses the C type '" + text(clang_getTypeSpelling(t)) + "'")
}

// ---------- #define numbers ----------

struct Number {
    CConst c
    bool ok
}

// "0x1F", "010", "10UL" -> the value, and whether the text was a whole number
fn parseInt(str lit) -> Number {
    s := lit
    base := 10
    if s.starts_with("0x") || s.starts_with("0X") {
        base = 16
        s = s.sub(2, s.len)
    } else if s.len > 1 && s[0] == '0' {
        base = 8
        s = s.sub(1, s.len)
    }
    n := 0
    seen := false
    i := 0
    while i < s.len {
        c := s[i]
        d := 99
        if c >= '0' && c <= '9' {
            d = int(c) - int('0')
        } else if c >= 'a' && c <= 'f' {
            d = int(c) - int('a') + 10
        } else if c >= 'A' && c <= 'F' {
            d = int(c) - int('A') + 10
        }
        if d >= base {
            break
        }
        n = n * base + d
        seen = true
        i += 1
    }
    // what is left may only be suffixes: 10UL
    while i < s.len {
        if !"uUlL".contains(str(s[i])) {
            return Number()
        }
        i += 1
    }
    if !seen && base != 8 {
        return Number()
    }
    return Number(c: CConst(i: n), ok: true)
}

// The tokens after a #define's name; `safe` is false if any of them could not be part of a
// constant expression (braces, semicolons, statements), so it is never handed to clang.
struct MacroTokens {
    []str parts
    bool safe
}

fn macroTokens(ptr[Importer] imp, CXCursor c) -> MacroTokens {
    ptr[CXToken] tokens = null
    u32 n = 0
    clang_tokenize(imp.tu, clang_getCursorExtent(c), addr(tokens), addr(n))
    out := MacroTokens(safe: true)
    allowed := ["(", ")", "+", "-", "*", "/", "%", "<<", ">>", "|", "&", "^", "~", "!", "<", ">", "<=", ">=", "==", "!=", "&&", "||", "?", ":", ",", "{", "}"]
    words := ["sizeof", "unsigned", "signed", "int", "long", "short", "char", "float", "double", "const", "_Bool"]
    depth := 0
    for k in 1..int(n) {            // token 0 is the macro's name
        kind := clang_getTokenKind(tokens[k])
        if kind == CXToken_Comment {
            continue
        }
        t := text(clang_getTokenSpelling(imp.tu, tokens[k]))
        out.parts.push(t)
        if kind == CXToken_Punctuation {
            if !allowed.contains(t) {
                out.safe = false
            }
            if t == "(" {
                depth += 1
            } else if t == ")" {
                depth -= 1
            }
        } else if kind == CXToken_Keyword && !words.contains(t) {
            out.safe = false
        }
    }
    clang_disposeTokens(imp.tu, tokens, n)
    if depth != 0 {
        out.safe = false
    }
    return out
}

// "text" as C writes it -> the text: \n \t \" \\ \0 and \xNN; "a" "b" are joined
fn cString([]str parts) -> Number {
    out := ""
    for p in parts {
        if p.len < 2 || p[0] != '"' || p[p.len - 1] != '"' {
            return Number()
        }
        i := 1
        while i < p.len - 1 {
            c := p[i]
            if c == '\\' && i + 1 < p.len - 1 {
                i += 1
                e := p[i]
                if e == 'n' {
                    c = '\n'
                } else if e == 't' {
                    c = '\t'
                } else if e == 'r' {
                    c = '\r'
                } else if e == '0' {
                    c = char(0)
                } else if e == 'x' {
                    v := 0
                    while i + 1 < p.len - 1 && "0123456789abcdefABCDEF".contains(str(p[i + 1])) {
                        i += 1
                        v = v * 16 + parseInt("0x" + str(p[i])).c.i
                    }
                    c = char(v & 255)
                } else {
                    c = e
                }
            }
            out = out + str(c)
            i += 1
        }
    }
    return Number(c: CConst(isStr: true, s: out), ok: true)
}

// Simple #defines: a single number, maybe negative, maybe in parentheses; or a "text".
fn macroValue(ptr[Importer] imp, CXCursor c) -> Number {
    parts := macroTokens(imp, c).parts
    if parts.len > 0 && parts[0].starts_with("\"") {
        return cString(parts)
    }

    while parts.len >= 2 && parts[0] == "(" && parts[parts.len - 1] == ")" {
        parts.remove(0)
        parts.pop()
    }
    neg := false
    if parts.len == 2 && parts[0] == "-" {
        neg = true
        parts.remove(0)
    }
    if parts.len != 1 {
        return Number()
    }
    lit := parts[0]
    if lit.len == 0 || !((lit[0] >= '0' && lit[0] <= '9') || lit[0] == '.') {
        return Number()
    }
    isFloat := (lit.contains(".") || lit.contains("e") || lit.contains("E")) && !lit.starts_with("0x")
    if isFloat {
        body := lit
        while body.len > 0 && "fFlL".contains(str(body[body.len - 1])) {
            body = body.sub(0, body.len - 1)
        }
        v := float(body) or {
            return Number()
        }
        if neg {
            v = 0.0 - v
        }
        return Number(c: CConst(isFloat: true, f: v, text: body), ok: true)
    }
    r := parseInt(lit)
    if r.ok && neg {
        r.c.i = 0 - r.c.i
    }
    return r
}

// ---------- the top level ----------

fn visitTop(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[Importer] imp = data
    visit(imp, c)
    return CXChildVisit_Continue
}

fn visit(ptr[Importer] imp, CXCursor c) {
    name := text(clang_getCursorSpelling(c))
    kind := clang_getCursorKind(c)
    if kind == CXCursor_TypedefDecl {
        // typedef struct {...} Name;  ->  the struct is called Name in Finch
        u := clang_getCanonicalType(clang_getTypedefDeclUnderlyingType(c))
        if u.kind == CXType_Record {
            usr := text(clang_getCursorUSR(clang_getTypeDeclaration(u)))
            // prefer the typedef name, unless the struct is already known under its tag
            used := imp.recordNames.has(usr) && imp.out.structs.has(imp.recordNames[usr])
            if !used && !imp.out.structs.has(name) {
                imp.recordNames[usr] = name
            }
            defineRecord(imp, u)        // usable even if no function mentions it: Motion m
        }
    } else if kind == CXCursor_FunctionDecl {
        if imp.out.fns.has(name) {
            return
        }
        f := CFunc(name: name, header: imp.header)
        if clang_Cursor_getStorageClass(c) == CX_SC_Static {
            f.inline = true         // mingw's printf and time, header-only helpers
        }
        ft := clang_getCanonicalType(clang_getCursorType(c))
        if ft.kind == CXType_FunctionNoProto {
            f.unsupported = "has no parameter list in its C declaration"
            imp.out.fns[name] = f
            return
        }
        r := mapType(imp, clang_getResultType(ft), true, false)
        if r.ok {
            f.ret = r.ty
        } else {
            f.unsupported = r.why
        }
        n := int(clang_getNumArgTypes(ft))
        for k in 0..n {
            if f.unsupported.len > 0 {
                break
            }
            p := mapType(imp, clang_getArgType(ft, u32(k)), true, true)
            if p.ok {
                f.params.push(p.ty)
            } else {
                f.unsupported = p.why
            }
        }
        f.variadic = clang_isFunctionTypeVariadic(ft) != 0
        imp.out.fns[name] = f
    } else if kind == CXCursor_VarDecl {
        if clang_Cursor_getStorageClass(c) != CX_SC_Extern || imp.out.globals.has(name) {
            return
        }
        g := mapType(imp, clang_getCursorType(c), false, false)
        if g.ok {
            imp.out.globals[name] = g.ty
        }
    } else if kind == CXCursor_StructDecl || kind == CXCursor_UnionDecl {
        if clang_isCursorDefinition(c) != 0 && name.len > 0 && !name.contains(" ") {
            usr := text(clang_getCursorUSR(c))
            if !imp.recordNames.has(usr) {
                imp.recordNames[usr] = name
            }
        }
    } else if kind == CXCursor_EnumDecl {
        clang_visitChildren(c, addr(visitTop), imp)
    } else if kind == CXCursor_EnumConstantDecl {
        if !imp.out.consts.has(name) {
            imp.out.consts[name] = CConst(i: int(clang_getEnumConstantDeclValue(c)))
        }
    } else if kind == CXCursor_MacroDefinition {
        if clang_Cursor_isMacroBuiltin(c) != 0 || clang_Cursor_isMacroFunctionLike(c) != 0 {
            return
        }
        if imp.out.consts.has(name) {
            return
        }
        v := macroValue(imp, c)
        if v.ok {
            imp.out.consts[name] = v.c
            return
        }
        mt := macroTokens(imp, c)
        if mt.safe && mt.parts.len > 0 {
            imp.exprMacros.push(name)        // (1 << 3), (FLAG_A | FLAG_B), ((Uint64)1): asked of clang later
        }
    }
}

// Read every header in `headers`; `dirs` are searched first for "local.h" headers.
// `target` is the LLVM triple the program is built for ("" = this system): sizes and headers depend on it.
fn importHeaders([]Header headers, []str dirs, str target, bool windows, str ccFor) -> CImports! {
    imp := Importer()
    if headers.len == 0 {
        return imp.out
    }
    []str args = ["-x", "c", "-std=gnu11"]
    if target.len > 0 {
        args.push("--target=" + target)
    }
    if windows {
        args.push("-D_USE_MATH_DEFINES")       // M_PI and friends, as on Linux
    }
    for d in dirs {
        args.push("-I" + d)
    }
    for d in systemIncludeArgs(ccFor) {
        args.push(d)
    }
    []ptr[char] argv
    for i in 0..args.len {
        argv.push(args[i].ptr)
    }
    index := clang_createIndex(0, 0)
    for hh in headers {
        h := hh
        if !looksLikeC(index, h, argv) {
            res := translateCpp(index, h, args, ccFor)
            if !res.ok {
                return error(h.where + ": error: the header '" + h.path + "' " + res.why)
            }
            for k in res.names.keys() {
                imp.out.cppNames[k] = res.names[k]
            }
            for k in res.skipped.keys() {
                if !imp.out.cppNames.has(k) {
                    imp.out.cppSkipped[k] = res.skipped[k]
                }
            }
            imp.out.cppFiles.push(res.cppfile)
            for o in res.opaque {
                imp.out.cppOpaque[o] = true
            }
            h = Header(path: res.cheader, where: h.where)
        }
        src := "#include \"" + h.path + "\"\n"
        file := host.unsavedFile("finch_import.c", src)
        ptr tu = null
        flags := CXTranslationUnit_DetailedPreprocessingRecord | CXTranslationUnit_SkipFunctionBodies
        err := clang_parseTranslationUnit2(index, "finch_import.c", argv.ptr, i32(argv.len), addr(file), 1, u32(flags), addr(tu))
        if err != CXError_Success || tu == null {
            return error(h.where + ": error: couldn't read C header '" + h.path + "'")
        }
        nd := int(clang_getNumDiagnostics(tu))
        for k in 0..nd {
            d := clang_getDiagnostic(tu, u32(k))
            if clang_getDiagnosticSeverity(d) >= CXDiagnostic_Error {
                msg := text(clang_getDiagnosticSpelling(d))
                clang_disposeDiagnostic(d)
                if msg.contains("file not found") {
                    // "'GL/gl.h' file not found": it may be a header that this one includes
                    missing := msg.sub(1, msg.sub(1, msg.len).find("'") + 1)
                    if missing == h.path {
                        return error(h.where + ": error: can't find the C header '" + h.path + "'")
                    }
                    return error(h.where + ": error: can't find the C header '" + missing + "', which '" + h.path + "' includes (is its library's development package installed?)")
                }
                return error(h.where + ": error: C header '" + h.path + "' has an error: " + msg)
            }
            clang_disposeDiagnostic(d)
        }
        imp.tu = tu
        imp.header = h.path
        clang_visitChildren(clang_getTranslationUnitCursor(tu), addr(visitTop), addr(imp))
        clang_disposeTranslationUnit(tu)
        evalMacros(addr(imp), index, h, argv)
    }
    clang_disposeIndex(index)
    return imp.out
}

// Does the header read as C? A C++ header (namespaces, classes, references) gives C errors other than a missing file.
fn looksLikeC(ptr index, Header h, []ptr[char] argv) -> bool {
    if h.path.ends_with(".hpp") || h.path.ends_with(".hh") || h.path.ends_with(".hxx") || h.path.ends_with(".h++") {
        return false
    }
    src := "#include \"" + h.path + "\"\n"
    file := host.unsavedFile("finch_probe.c", src)
    ptr tu = null
    err := clang_parseTranslationUnit2(index, "finch_probe.c", argv.ptr, i32(argv.len), addr(file), 1, u32(CXTranslationUnit_SkipFunctionBodies), addr(tu))
    if err != CXError_Success || tu == null {
        return true                 // the real import says what is wrong
    }
    out := true
    nd := int(clang_getNumDiagnostics(tu))
    for k in 0..nd {
        d := clang_getDiagnostic(tu, u32(k))
        msg := text(clang_getDiagnosticSpelling(d))
        if clang_getDiagnosticSeverity(d) >= CXDiagnostic_Error {
            if !msg.contains("file not found") {
                out = false
            } else if msg.starts_with("'") && !msg.sub(1, msg.len).sub(0, msg.sub(1, msg.len).find("'")).contains(".") {
                out = false         // <string>, <vector>: only C++ has headers without an extension
            }
        }
        clang_disposeDiagnostic(d)
    }
    clang_disposeTranslationUnit(tu)
    return out
}

// #defines that are expressions: each becomes `static const __auto_type __finch_m_NAME = (NAME);`
// in a second look at the header, and clang works out the value. One that isn't a constant
// (a type, a function call) just gives clang an error there, and is left out.
fn evalMacros(ptr[Importer] imp, ptr index, Header h, []ptr[char] argv) {
    if imp.exprMacros.len == 0 {
        return
    }
    src := "#include \"" + h.path + "\"\n"
    for m in imp.exprMacros {
        src = src + "static const __auto_type __finch_m_" + m + " = (" + m + ");\n"
    }
    []str none
    imp.exprMacros = none
    file := host.unsavedFile("finch_macros.c", src)
    ptr tu = null
    err := clang_parseTranslationUnit2(index, "finch_macros.c", argv.ptr, i32(argv.len), addr(file), 1, u32(CXTranslationUnit_SkipFunctionBodies), addr(tu))
    if err != CXError_Success || tu == null {
        return
    }
    clang_visitChildren(clang_getTranslationUnitCursor(tu), addr(visitMacroVar), imp)
    clang_disposeTranslationUnit(tu)
}

// a float as a Finch literal: 2.0, not 2
fn floatText(float v) -> str {
    t := str(v)
    if !t.contains(".") && !t.contains("e") {
        t = t + ".0"
    }
    return t
}

// (Color){ 245, 245, 245, 255 }: a struct whose fields are all numbers, in order
fn structMacro(ptr[Importer] imp, str name, CXCursor c, CXType t) {
    sname := recordName(imp, t)
    if !imp.out.structs.has(sname) {
        return
    }
    find := InitFind(ok: true)
    clang_visitChildren(c, addr(visitFindInit), addr(find))
    if !find.found {
        return
    }
    clang_visitChildren(find.list, addr(visitInitField), addr(find))
    if !find.ok || find.fields.len == 0 || find.fields.len > imp.out.structs[sname].fields.len {
        return
    }
    imp.out.consts[name] = CConst(structName: sname, fields: find.fields, fieldFloat: find.floats)
}

fn visitFindInit(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[InitFind] f = data
    if clang_getCursorKind(c) == CXCursor_InitListExpr {
        f.found = true
        f.list = c
        return CXChildVisit_Break
    }
    return CXChildVisit_Recurse
}

fn visitInitField(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[InitFind] f = data
    r := clang_Cursor_Evaluate(c)
    if r == null {
        f.ok = false
        return CXChildVisit_Break
    }
    k := clang_EvalResult_getKind(r)
    if k == CXEval_Int {
        f.fields.push(str(int(clang_EvalResult_getAsLongLong(r))))
        f.floats.push(false)
    } else if k == CXEval_Float {
        v := clang_EvalResult_getAsDouble(r)
        if v == v && v - v == 0.0 {
            f.fields.push(floatText(v))
            f.floats.push(true)
        } else {
            f.ok = false
        }
    } else {
        f.ok = false            // a struct in the struct, a pointer, a text: not a simple constant
    }
    clang_EvalResult_dispose(r)
    if !f.ok {
        return CXChildVisit_Break
    }
    return CXChildVisit_Continue
}

fn visitMacroVar(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[Importer] imp = data
    if clang_getCursorKind(c) != CXCursor_VarDecl {
        return CXChildVisit_Continue
    }
    name := text(clang_getCursorSpelling(c))
    if !name.starts_with("__finch_m_") {
        return CXChildVisit_Continue
    }
    name = name.sub(10, name.len)
    if imp.out.consts.has(name) {
        return CXChildVisit_Continue
    }
    t := clang_getCanonicalType(clang_getCursorType(c))
    if t.kind == CXType_Record {
        structMacro(imp, name, c, t)
        return CXChildVisit_Continue
    }
    r := clang_Cursor_Evaluate(c)
    if r == null {
        return CXChildVisit_Continue
    }
    k := clang_EvalResult_getKind(r)
    if k == CXEval_Int {
        imp.out.consts[name] = CConst(i: int(clang_EvalResult_getAsLongLong(r)))
    } else if k == CXEval_Float {
        v := clang_EvalResult_getAsDouble(r)
        if v == v && v - v == 0.0 {         // not nan or inf
            imp.out.consts[name] = CConst(isFloat: true, f: v, text: floatText(v))
        }
    } else if k == CXEval_StrLiteral {
        imp.out.consts[name] = CConst(isStr: true, s: clang_EvalResult_getAsStr(r))
    }
    clang_EvalResult_dispose(r)
    return CXChildVisit_Continue
}

// ---------- C++ headers ----------
//
// A header that isn't C (namespaces, classes, references, default arguments) is read as C++. Finch then writes two
// files into its cache, both made from the header:
//   a C++ file of small `extern "C"` functions, one per function, method, constructor and destructor (and one per
//   number of arguments, where some have defaults: C++ itself fills in the rest);
//   a C header that says what those functions and the plain structs look like,
// imports that C header like any other, and links the C++ file. In the program:
//   ImGui.Button("OK")          a function in a namespace (nested ones joined with _: outer_inner.f)
//   win.SetSize(800, 600)       a method, on a pointer to the class or on a struct
//   Thing.new(1, 2)             a constructor: a ptr[Thing];  t.delete()  the destructor
// A C++ exception becomes a runtime error that says what it was.

struct CppTy {
    bool ok
    str why
    str c           // as the C header writes it
    str cpp         // as the C++ wrapper writes the parameter or result
    str pre         // what turns the C value into the C++ argument: pre + name + post
    str post
    bool plain      // a C-layout value (numbers, enums, plain structs): a `const T&` can take a copy
}

struct CppGen {
    ptr tu
    str header
    str prefix
    int n
    []str decls                 // the C header: structs and enums, in an order C accepts
    []str protos                // the C header: the wrappers
    []str bodies                // the C++ file: the wrappers
    map[str]str records         // record USR -> its C name
    map[str]bool layout         // C name -> true if it is a plain struct the C header spells out
    map[str][]str names         // name in Finch -> the wrappers (one per number of arguments, per overload)
    map[str]str skipped         // name in Finch -> why it couldn't be wrapped
    []str spaces                // the namespace path while visiting
    str owner                   // the class being visited, as C names it ("" outside a class)
    str ownerCpp                // and as C++ names it
}

struct CppResult {
    bool ok
    str why
    str cheader
    str cppfile
    map[str][]str names
    map[str]str skipped
    []str opaque
}

fn cppHash(str s) -> str {
    h := 7
    for c in s {
        h = (h * 31 + int(c)) % 1000000007
    }
    if h < 0 {
        h = -h
    }
    return str(h)
}

fn cppSpell(CXType t) -> str {
    return text(clang_getTypeSpelling(t))
}

fn cppCName(str spelled) -> str {
    s := spelled.replace("::", "_").replace("<", "_").replace(",", "_").replace("*", "p").replace("&", "r")
    out := ""
    for ch in s {
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' {
            out = out + str(ch)
        }
    }
    while out.starts_with("_") {
        out = out.sub(1, out.len)
    }
    if out.starts_with("struct") {
        out = out.sub(6, out.len)
    }
    if out.starts_with("class") {
        out = out.sub(5, out.len)
    }
    return out
}

fn cppNo(str why) -> CppTy {
    return CppTy(ok: false, why: why)
}

// the names of what can be numbers in both languages
fn cppBuiltin(CXType t) -> bool {
    k := t.kind
    return k == CXType_Bool || k == CXType_Char_U || k == CXType_UChar || k == CXType_UShort || k == CXType_UInt ||
           k == CXType_ULong || k == CXType_ULongLong || k == CXType_Char_S || k == CXType_SChar || k == CXType_Short ||
           k == CXType_Int || k == CXType_Long || k == CXType_LongLong || k == CXType_Float || k == CXType_Double
}

// A C++ type as the two files write it.
fn cppType(ptr[CppGen] gen, CXType type) -> CppTy {
    t := clang_getCanonicalType(type)
    k := t.kind
    if k == CXType_Void {
        return CppTy(ok: true, c: "void", cpp: "void")
    }
    if cppBuiltin(t) {
        s := cppSpell(t).replace("const ", "")
        return CppTy(ok: true, c: s, cpp: s, plain: true)
    }
    if k == CXType_Enum {
        it := cppSpell(clang_getCanonicalType(clang_getEnumDeclIntegerType(clang_getTypeDeclaration(t))))
        return CppTy(ok: true, c: it, cpp: it, pre: "(" + cppSpell(t).replace("const ", "") + ")(", post: ")", plain: true)
    }
    if k == CXType_Pointer {
        p := clang_getCanonicalType(clang_getPointeeType(t))
        if p.kind == CXType_FunctionProto || p.kind == CXType_FunctionNoProto || cppSpell(t).contains("(") {
            // functions, and pointers to them: a plain pointer, cast back in the wrapper
            return CppTy(ok: true, c: "void *", cpp: "void *", pre: "reinterpret_cast<" + cppSpell(t) + ">(", post: ")")
        }
        cq := ""
        if clang_isConstQualifiedType(p) != 0 {
            cq = "const "
        }
        if p.kind == CXType_Void {
            return CppTy(ok: true, c: cq + "void *", cpp: cppSpell(t))
        }
        if p.kind == CXType_Record {
            return CppTy(ok: true, c: cq + cppRecord(gen, p) + " *", cpp: cppSpell(t))
        }
        inner := cppType(gen, p)
        if !inner.ok {
            return inner
        }
        if p.kind == CXType_Enum {
            return CppTy(ok: true, c: cq + inner.c + " *", cpp: cq + inner.c + " *", pre: "reinterpret_cast<" + cppSpell(t) + ">(", post: ")")
        }
        return CppTy(ok: true, c: cq + inner.c + " *", cpp: cppSpell(t))
    }
    if k == CXType_LValueReference || k == CXType_RValueReference {
        p := clang_getCanonicalType(clang_getPointeeType(t))
        isConst := clang_isConstQualifiedType(p) != 0
        if p.kind == CXType_Record {
            rn := cppRecord(gen, p)
            if !(isConst && gen.layout.has(rn)) {
                cq := ""
                if isConst {
                    cq = "const "
                }
                return CppTy(ok: true, c: cq + rn + " *", cpp: cppSpell(p) + " *", pre: "*", post: "")
            }
        }
        inner := cppType(gen, p)
        if !inner.ok {
            return inner
        }
        if isConst && inner.plain {
            return inner                // const T&: the wrapper takes a copy and lends it
        }
        cq := ""
        if isConst {
            cq = "const "
        }
        if p.kind == CXType_Enum {
            return CppTy(ok: true, c: cq + inner.c + " *", cpp: cq + inner.c + " *", pre: "*reinterpret_cast<" + cppSpell(p) + " *>(", post: ")")
        }
        return CppTy(ok: true, c: cq + inner.c + " *", cpp: cppSpell(p) + " *", pre: "*", post: "")
    }
    if k == CXType_Record {
        name := cppRecord(gen, t)
        if !gen.layout.has(name) {
            return cppNo("passes the C++ class " + cppSpell(t) + " by value (it can be used through a pointer)")
        }
        return CppTy(ok: true, c: name, cpp: cppSpell(t).replace("const ", ""), plain: true)
    }
    return cppNo("uses the C++ type " + cppSpell(t) + ", which Finch can't pass yet")
}

struct CppFields {
    ptr[CppGen] gen
    []str lines
    bool plain
}

fn cppVisitRecordPart(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[CppFields] f = data
    kind := clang_getCursorKind(c)
    if kind == CXCursor_CXXBaseSpecifier {
        f.plain = false
    } else if kind == CXCursor_CXXMethod && clang_CXXMethod_isVirtual(c) != 0 {
        f.plain = false
    } else if kind == CXCursor_Constructor && clang_CXXMethod_isDefaulted(c) == 0 && (clang_CXXConstructor_isCopyConstructor(c) != 0 || clang_CXXConstructor_isMoveConstructor(c) != 0) {
        f.plain = false             // its own copy: C++ passes it differently from a C struct
    } else if kind == CXCursor_Destructor && clang_CXXMethod_isDefaulted(c) == 0 {
        f.plain = false
    } else if kind == CXCursor_FieldDecl {
        if clang_getCXXAccessSpecifier(c) != CX_CXXPublic || clang_Cursor_isBitField(c) != 0 {
            f.plain = false
            return CXChildVisit_Continue
        }
        name := text(clang_getCursorSpelling(c))
        ft := clang_getCanonicalType(clang_getCursorType(c))
        count := ""
        if ft.kind == CXType_ConstantArray {
            count = "[" + str(int(clang_getNumElements(ft))) + "]"
            ft = clang_getCanonicalType(clang_getArrayElementType(ft))
        }
        m := cppType(f.gen, ft)
        if !m.ok || ft.kind == CXType_LValueReference || ft.kind == CXType_RValueReference {
            f.plain = false
            return CXChildVisit_Continue
        }
        f.lines.push("    " + m.c + " " + name + count + ";")
    }
    return CXChildVisit_Continue
}

// A record's C name. A plain one (public fields only, no bases, nothing virtual) is spelled out in the C header so
// Finch can make it and pass it by value; any other is opaque: Finch only holds pointers to it.
fn cppRecord(ptr[CppGen] gen, CXType type) -> str {
    t := clang_getCanonicalType(type)
    decl := clang_getTypeDeclaration(t)
    usr := text(clang_getCursorUSR(decl))
    if gen.records.has(usr) {
        return gen.records[usr]
    }
    name := cppCName(cppSpell(t).replace("const ", ""))
    gen.records[usr] = name
    gen.decls.push("typedef struct " + name + " " + name + ";")
    def := clang_getCursorDefinition(decl)
    if clang_Cursor_isNull(def) != 0 || clang_Type_getSizeOf(t) < 0 {
        return name
    }
    f := CppFields(gen: gen, plain: true)
    clang_visitChildren(def, addr(cppVisitRecordPart), addr(f))
    if f.plain && f.lines.len > 0 {
        gen.decls.push("struct " + name + " {\n" + f.lines.join("\n") + "\n};")
        gen.layout[name] = true
    }
    return name
}

struct CppDefault {
    bool found
}

fn cppVisitDefault(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[CppDefault] d = data
    if clang_isExpression(clang_getCursorKind(c)) != 0 {
        d.found = true
        return CXChildVisit_Break
    }
    return CXChildVisit_Continue
}

fn cppHasDefault(CXCursor param) -> bool {
    d := CppDefault()
    clang_visitChildren(param, addr(cppVisitDefault), addr(d))
    return d.found
}

// One function, method, constructor or destructor: a wrapper for each number of arguments it can be called with.
//   how: "fn" (call = the qualified name), "method" (self->name), "static", "new", "delete"
fn cppWrap(ptr[CppGen] gen, CXCursor c, str finchName, str how, str call) {
    nargs := int(clang_Cursor_getNumArguments(c))
    []CppTy params
    firstDefault := nargs
    for k in 0..nargs {
        a := clang_Cursor_getArgument(c, u32(k))
        m := cppType(gen, clang_getCursorType(a))
        if !m.ok {
            if !gen.names.has(finchName) {
                gen.skipped[finchName] = m.why
            }
            return
        }
        if cppHasDefault(a) && firstDefault == nargs {
            firstDefault = k
        }
        params.push(m)
    }
    ret := CppTy(ok: true, c: "void", cpp: "void")
    if how == "new" {
        ret = CppTy(ok: true, c: gen.owner + " *", cpp: gen.ownerCpp + " *")
    } else if how != "delete" {
        rt := clang_getCanonicalType(clang_getCursorResultType(c))
        ret = cppType(gen, rt)
        if !ret.ok {
            if !gen.names.has(finchName) {
                gen.skipped[finchName] = ret.why.replace("passes", "returns").replace("uses", "returns")
            }
            return
        }
        if rt.kind == CXType_LValueReference || rt.kind == CXType_RValueReference {
            ret.pre = "&("             // a reference comes back as a pointer to the same thing
            ret.post = ")"
            pointee := clang_getCanonicalType(clang_getPointeeType(rt))
            if ret.plain && !ret.c.ends_with("*") {
                cq := ""
                if clang_isConstQualifiedType(pointee) != 0 {
                    cq = "const "
                }
                ret.c = cq + ret.c + " *"
                ret.cpp = cppSpell(pointee) + " *"
            }
        } else if rt.kind == CXType_Enum {
            ret.pre = "(" + ret.c + ")("
            ret.post = ")"
        } else if ret.c == "void *" && ret.cpp == "void *" && rt.kind == CXType_Pointer {
            ret.pre = "reinterpret_cast<void *>("      // a function pointer comes back as a plain pointer
            ret.post = ")"
        } else {
            ret.pre = ""
            ret.post = ""
        }
    }
    variadic := clang_Cursor_isVariadic(c) != 0
    self := how == "method" || how == "delete"
    for count in firstDefault..nargs + 1 {
        wname := gen.prefix + str(gen.n)
        gen.n += 1
        []str cps
        []str cpps
        []str args
        if self {
            cps.push(gen.owner + " *self")
            cpps.push(gen.ownerCpp + " *self")
        }
        for k in 0..count {
            cps.push(params[k].c + " a" + str(k))
            cpps.push(params[k].cpp + " a" + str(k))
            args.push(params[k].pre + "a" + str(k) + params[k].post)
        }
        if variadic && count > 0 && params[count - 1].c == "const char *" {
            last := args.pop()
            args.push("\"%s\"")         // Text("50%") prints 50%: the text is never a format
            args.push(last)
        }
        expr := ""
        if how == "new" {
            expr = "new " + call + "(" + args.join(", ") + ")"
        } else if how == "delete" {
            expr = "delete self"
        } else if how == "method" {
            expr = "self->" + call + "(" + args.join(", ") + ")"
        } else {
            expr = call + "(" + args.join(", ") + ")"
        }
        cpl := cps.join(", ")
        if cpl.len == 0 {
            cpl = "void"
        }
        gen.protos.push(ret.c + " " + wname + "(" + cpl + ");")
        body := ""
        if ret.c == "void" {
            body = expr + ";"
        } else {
            body = "return " + ret.pre + expr + ret.post + ";"
        }
        never := ""
        if ret.c != "void" {
            never = " __builtin_unreachable();"      // a value always came back, or finch_cpp_failed stopped the program
        }
        gen.bodies.push("extern \"C\" " + ret.cpp + " " + wname + "(" + cpps.join(", ") + ") { FINCH_TRY " + body + " FINCH_CATCH" + never + " }")
        if !gen.names.has(finchName) {
            []str none
            gen.names[finchName] = none
        }
        gen.names[finchName].push(wname)
        gen.skipped.remove(finchName)
    }
}

fn cppFromHeader(ptr[CppGen] gen, CXCursor c) -> bool {
    ptr file = null
    u32 line = 0
    u32 col = 0
    u32 off = 0
    clang_getExpansionLocation(clang_getCursorLocation(c), addr(file), addr(line), addr(col), addr(off))
    if file == null {
        return false
    }
    name := text(clang_getFileName(file)).replace("\\", "/")
    return name == gen.header || name.ends_with("/" + gen.header)
}

fn cppPublic(CXCursor c) -> bool {
    a := clang_getCXXAccessSpecifier(c)
    return a == CX_CXXPublic || a == CX_CXXInvalidAccessSpecifier
}

fn cppVisitClass(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[CppGen] gen = data
    kind := clang_getCursorKind(c)
    if !cppPublic(c) || clang_CXXMethod_isDeleted(c) != 0 {
        return CXChildVisit_Continue
    }
    name := text(clang_getCursorSpelling(c))
    if name.starts_with("operator") || name.starts_with("~") && kind != CXCursor_Destructor {
        return CXChildVisit_Continue
    }
    if kind == CXCursor_CXXMethod {
        if clang_CXXMethod_isStatic(c) != 0 {
            cppWrap(gen, c, gen.owner + "." + name, "static", gen.ownerCpp + "::" + name)
        } else {
            cppWrap(gen, c, gen.owner + "#" + name, "method", name)
        }
    } else if kind == CXCursor_Constructor {
        if clang_CXXConstructor_isCopyConstructor(c) == 0 && clang_CXXConstructor_isMoveConstructor(c) == 0 {
            cppWrap(gen, c, gen.owner + ".new", "new", gen.ownerCpp)
        }
    } else if kind == CXCursor_Destructor {
        cppWrap(gen, c, gen.owner + "#delete", "delete", "")
    }
    return CXChildVisit_Continue
}

fn cppVisit(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[CppGen] gen = data
    kind := clang_getCursorKind(c)
    name := text(clang_getCursorSpelling(c))
    if kind == CXCursor_Namespace {
        gen.spaces.push(name)
        clang_visitChildren(c, addr(cppVisit), data)
        gen.spaces.pop()
        return CXChildVisit_Continue
    }
    if kind == CXCursor_LinkageSpec {
        clang_visitChildren(c, addr(cppVisit), data)
        return CXChildVisit_Continue
    }
    if !cppFromHeader(gen, c) {
        return CXChildVisit_Continue
    }
    qual := ""
    for s in gen.spaces {
        qual = qual + s + "::"
    }
    if kind == CXCursor_FunctionDecl {
        if name.starts_with("operator") || clang_getCursorKind(clang_getCursorSemanticParent(c)) == CXCursor_ClassDecl {
            return CXChildVisit_Continue
        }
        finchName := name
        if gen.spaces.len > 0 {
            finchName = gen.spaces.join("_") + "." + name
        }
        cppWrap(gen, c, finchName, "fn", "::" + qual + name)
    } else if (kind == CXCursor_StructDecl || kind == CXCursor_ClassDecl) && clang_isCursorDefinition(c) != 0 && name.len > 0 {
        t := clang_getCursorType(c)
        savedO := gen.owner
        savedC := gen.ownerCpp
        gen.owner = cppRecord(gen, t)
        gen.ownerCpp = "::" + qual + name
        clang_visitChildren(c, addr(cppVisitClass), data)
        gen.owner = savedO
        gen.ownerCpp = savedC
    } else if kind == CXCursor_EnumDecl {
        // its values, as plain C constants: ImGuiWindowFlags_NoTitleBar
        clang_visitChildren(c, addr(cppVisitEnum), data)
    }
    return CXChildVisit_Continue
}

fn cppVisitEnum(CXCursor c, CXCursor parent, ptr data) -> i32 {
    ptr[CppGen] gen = data
    if clang_getCursorKind(c) == CXCursor_EnumConstantDecl {
        name := text(clang_getCursorSpelling(c))
        if clang_EnumDecl_isScoped(parent) != 0 {
            name = text(clang_getCursorSpelling(parent)) + "_" + name       // enum class Color { Red }: Color_Red
        }
        gen.decls.push("#define " + name + " (" + str(int(clang_getEnumConstantDeclValue(c))) + "LL)")
    }
    return CXChildVisit_Continue
}

// the C++ compiler that goes with a C compiler: clang -> clang++, gcc -> g++, cc -> c++
fn cppCompilerFor(str cc) -> str {
    if cc.ends_with("clang") {
        return cc + "++"
    }
    if cc.ends_with("gcc") {
        return cc.sub(0, cc.len - 3) + "g++"
    }
    if cc.ends_with("cc") {
        return cc.sub(0, cc.len - 2) + "c++"
    }
    return cc
}

// Read a C++ header and write its two files. `args` are the C arguments (-I, --target, system folders).
fn translateCpp(ptr index, Header h, []str baseArgs, str ccFor) -> CppResult {
    []str args = ["-x", "c++", "-std=c++17"]
    for a in baseArgs {
        if a != "-x" && a != "c" && !a.starts_with("-std=") && !a.starts_with("-isystem") && !a.starts_with("-iframework") {
            args.push(a)
        }
    }
    for d in systemIncludeArgsFor(cppCompilerFor(ccFor), "c++") {
        args.push(d)
    }
    []ptr[char] argv
    for i in 0..args.len {
        argv.push(args[i].ptr)
    }
    src := "#include \"" + h.path + "\"\n"
    file := host.unsavedFile("finch_import.cpp", src)
    ptr tu = null
    err := clang_parseTranslationUnit2(index, "finch_import.cpp", argv.ptr, i32(argv.len), addr(file), 1, u32(CXTranslationUnit_SkipFunctionBodies), addr(tu))
    if err != CXError_Success || tu == null {
        return CppResult(why: "couldn't read it as C or as C++")
    }
    nd := int(clang_getNumDiagnostics(tu))
    for k in 0..nd {
        d := clang_getDiagnostic(tu, u32(k))
        if clang_getDiagnosticSeverity(d) >= CXDiagnostic_Error {
            msg := text(clang_getDiagnosticSpelling(d))
            clang_disposeDiagnostic(d)
            clang_disposeTranslationUnit(tu)
            return CppResult(why: "has an error (as C and as C++): " + msg)
        }
        clang_disposeDiagnostic(d)
    }
    key := cppHash(h.path + "|" + args.join(" "))
    gen := CppGen(tu: tu, header: h.path.replace("\\", "/"), prefix: "finch_cpp_" + key + "_")
    clang_visitChildren(clang_getTranslationUnitCursor(tu), addr(cppVisit), addr(gen))
    clang_disposeTranslationUnit(tu)
    dir := host.cacheDir() + "/cpp"
    host.makeDirs(dir)
    base := dir + "/" + cppCName(h.path.replace("/", "_").replace(".", "_")) + "_" + key
    cheader := "// Made by Finch from " + h.path + ": what its C++ wrappers look like from C.\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n" +
               gen.decls.join("\n") + "\n" + gen.protos.join("\n") + "\n"
    cpp := "// Made by Finch from " + h.path + ": C functions for what it has in C++.\n#include \"" + h.path + "\"\n#include <exception>\n" +
           "extern \"C\" [[noreturn]] void finch_cpp_failed(const char *what);\n" +
           "#if defined(__clang__)\n#pragma clang diagnostic ignored \"-Wreturn-type-c-linkage\"\n#endif\n" +
           "#if defined(__cpp_exceptions) || defined(__EXCEPTIONS)\n" +
           "#include <cstring>\n" +
           "static void finch_keep_(char *to, const char *what) { std::strncpy(to, what ? what : \"\", 511); to[511] = 0; }\n" +
           "// the message is kept and the program stops after the catch, when the exception is gone\n" +
           "#define FINCH_TRY bool finch_threw_ = false; char finch_what_[512]; try {\n" +
           "#define FINCH_CATCH } catch (const std::exception &e) { finch_threw_ = true; finch_keep_(finch_what_, e.what()); } catch (...) { finch_threw_ = true; finch_keep_(finch_what_, \"an exception that isn't a std::exception\"); } if (finch_threw_) finch_cpp_failed(finch_what_);\n" +
           "#else\n#define FINCH_TRY {\n#define FINCH_CATCH }\n#endif\n" + gen.bodies.join("\n") + "\n"
    write_file(base + ".h", cheader)
    write_file(base + ".cpp", cpp)
    []str opaque
    for k in gen.records.keys() {
        if !gen.layout.has(gen.records[k]) {
            opaque.push(gen.records[k])
        }
    }
    return CppResult(ok: true, cheader: base + ".h", cppfile: base + ".cpp", names: gen.names, skipped: gen.skipped, opaque: opaque)
}
