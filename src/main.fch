// finch-boot: the Finch compiler written in Finch.
//
//   finch-boot build <file.fch> [-o name]    compile a program
//   finch-boot ir    <file.fch>              print the LLVM IR
//
// It reads the program and the modules it imports, checks it, writes LLVM IR as text
// and lets clang turn that into a program, linked with Finch's C runtime.
import lexer
import ast
import parser
import gen
import cimport
import platform
import linker
import lsp
import host
import embedded
import "stdlib.h"

fn dirOf(str path) -> str {
    i := path.len - 1
    while i >= 0 && path[i] != '/' {
        i -= 1
    }
    if i < 0 {
        return "."
    }
    return path.sub(0, i)
}

// the path from the root, so the same file is the same in the cache wherever finch is started
fn absolute(str path) -> str {
    if path.starts_with("/") || (path.len > 2 && path[1] == ':') {
        return path
    }
    return host.cwd() + "/" + path
}

fn stem(str path) -> str {
    name := path.sub(dirOf(path).len + 1, path.len)
    if dirOf(path) == "." && !path.starts_with("./") {
        name = path
    }
    dot := name.find(".")
    if dot > 0 {
        return name.sub(0, dot)
    }
    return name
}

struct Loader {
    []ast.Program progs
    []str files
    []str loaded
    str os              // "windows", "macos" or "linux": a module may have a version for each (time_windows.fch)
    str std             // the standard library's folder, or ""
    []str paths         // FINCH_PATH: more folders to look for modules in
    str root            // the main file's folder: modules are named by their path from here (ui/button)
    []str overlayPaths  // --overlay path=file: read `path` from `file` (the text an editor has, not saved yet)
    []str overlayFiles
}

fn textOfFile(ptr[Loader] l, str path) -> str {
    k := l.overlayPaths.find(path)
    if k >= 0 {
        return read_file(l.overlayFiles[k])
    }
    return read_file(path)
}

// import json: the file next to the one that imports it, else the standard library's.
// A program's own json.fch wins over the library's.
fn findModule(ptr[Loader] l, str from, str name) -> str {
    // in each folder, the version for this system first: time_windows.fch, then time.fch
    local := dirOf(from) + "/" + name + ".fch"
    if file_exists(dirOf(from) + "/" + name + "_" + l.os + ".fch") {
        return dirOf(from) + "/" + name + "_" + l.os + ".fch"
    }
    if file_exists(local) {
        return local
    }
    for d in l.paths {
        if file_exists(d + "/" + name + "_" + l.os + ".fch") {
            return d + "/" + name + "_" + l.os + ".fch"
        }
        if file_exists(d + "/" + name + ".fch") {
            return d + "/" + name + ".fch"
        }
    }
    if l.std.len > 0 {
        if file_exists(l.std + "/" + name + "_" + l.os + ".fch") {
            return l.std + "/" + name + "_" + l.os + ".fch"
        }
        if file_exists(l.std + "/" + name + ".fch") {
            return l.std + "/" + name + ".fch"
        }
    }
    return local
}

// A module is named by its file, so `import button` in ui/menu.fch and `import ui/button` in main.fch
// are the same module, and two different util.fch files are two modules.
fn moduleKey(ptr[Loader] l, str file, str name) -> str {
    []str roots
    roots.push(l.root)
    for d in l.paths {
        roots.push(d)
    }
    roots.push(l.std)
    for r in roots {
        if r.len > 0 && file.starts_with(r + "/") && file.ends_with(".fch") {
            key := file.sub(r.len + 1, file.len - 4)
            if key.ends_with("_" + l.os) {
                key = key.sub(0, key.len - l.os.len - 1)        // time_windows.fch is the module time
            }
            return key
        }
    }
    return name
}

fn load(ptr[Loader] l, str path, str module) {
    if !file_exists(path) && !l.overlayPaths.contains(path) {
        if module.len > 0 {
            print("error: can't find the module '" + module + "' (looked for " + path + ")")
        } else {
            print("error: can't open '" + path + "'")
        }
        exit(1)
    }
    src := textOfFile(l, path)
    file := l.files.len
    l.files.push(path)
    prog := parser.parse(lexer.lex(src, path), file, path)
    prog.module = module
    prog.path = path
    if module.len == 0 {
        l.root = dirOf(path)
    }
    []str files
    for i in 0..prog.modules.len {
        f := findModule(l, path, prog.modules[i])
        files.push(f)
        prog.modules[i] = moduleKey(l, f, prog.modules[i])
    }
    modules := prog.modules
    l.progs.push(prog)
    for i in 0..modules.len {
        if !l.loaded.contains(modules[i]) {
            l.loaded.push(modules[i])
            load(l, files[i], modules[i])
        }
    }
}

fn usage() {
    print("Finch -- the compiler is written in Finch")
    print("usage:")
    print("  finch run <file.fch> [args...]     build and run a program")
    print("  finch build <file.fch> [-o name]   build a program")
    print("  finch test <file.fch>              run its test \"...\" { } blocks (and those of the modules it imports)")
    print("  finch ir <file.fch>                print the LLVM IR")
    print("  finch version                      show the version")
    print("  finch lsp                          the language server, for editors (VS Code, Kate, ...)")
    print("options:")
    print("  -O0               no optimization (faster to build)")
    print("  -l <lib>          link a library (the same as  link \"lib\"  in the program)")
    print("  -I <dir>          look for imported C headers there too")
    print("  -g                debug info (for gdb and lldb; use -O0 with it)")
    print("  --trace           runtime errors show the chain of calls (finch run, finch test, -g and -O0 do it anyway)")
    print("  --no-trace        they don't (finch build without -g or -O0 doesn't, it costs speed)")
    print("  --target <name>   build for another system: windows, linux, arm64 (Linux), macos, or an LLVM triple")
    exit(1)
}

// The runtime and the standard library are carried inside the compiler (embedded.fch). When they aren't found as
// files next to it, they are written to the cache folder, once, and used from there.
fn unpack() -> str {
    names := embedded.names()
    dir := host.cacheDir() + "/files-" + linker.fingerprint(embedded.texts().join("\n"))
    if file_exists(dir + "/done") {
        return dir
    }
    texts := embedded.texts()
    for i in 0..names.len {
        host.makeDirs(dirOf(dir + "/" + names[i]))
        write_file(dir + "/" + names[i], texts[i])
    }
    write_file(dir + "/done", "")
    return dir
}

fn main([]str args) -> int {
    if args.len == 2 && (args[1] == "version" || args[1] == "--version") {
        print("Finch 2.4.0 (the compiler is written in Finch)")
        return 0
    }
    if args.len == 2 && args[1] == "lsp" {
        return lsp.run(args[0])             // the language server, for editors
    }
    if args.len < 3 {
        usage()
    }
    cmd := args[1]
    file := args[2]
    if cmd != "build" && cmd != "run" && cmd != "ir" && cmd != "index" && cmd != "test" {
        usage()
    }
    out := stem(file)
    outGiven := false
    shared := false
    debug := false
    trace := cmd != "build"         // finch build: only with --trace, -g or -O0 (the chain costs speed)
    traceGiven := false
    targetName := ""
    opt := "-O2"
    []str extraLibs
    []str extraDirs
    []str overlayPaths
    []str overlayFiles
    []str progArgs
    ai := 3
    while ai < args.len {
        a := args[ai]
        if cmd == "run" && progArgs.len > 0 {          // after the first argument of the program, all of them are its
            progArgs.push(a)
        } else if a == "-o" && ai + 1 < args.len && cmd == "build" {
            out = args[ai + 1]
            outGiven = true
            ai += 1
        } else if a == "--shared" && cmd == "build" {
            shared = true
        } else if a == "-O0" {
            opt = "-O0"
        } else if a == "-l" && ai + 1 < args.len {
            extraLibs.push(args[ai + 1])
            ai += 1
        } else if a.starts_with("-l") && a.len > 2 {
            extraLibs.push(a.sub(2, a.len))
        } else if a == "-I" && ai + 1 < args.len {
            extraDirs.push(args[ai + 1])
            ai += 1
        } else if a == "--overlay" && ai + 1 < args.len {
            both := args[ai + 1].split("=")
            overlayPaths.push(both[0])
            overlayFiles.push(both[1])
            ai += 1
        } else if a == "-g" {
            debug = true
        } else if a == "--no-trace" {
            trace = false
            traceGiven = true
        } else if a == "--trace" {
            trace = true
            traceGiven = true
        } else if a == "--target" && ai + 1 < args.len {
            targetName = args[ai + 1]
            ai += 1
        } else if cmd == "run" {
            progArgs.push(a)
        } else {
            usage()
        }
        ai += 1
    }
    if !traceGiven && (debug || opt == "-O0") {
        trace = true
    }
    tg := platform.select(targetName)
    if cmd == "run" || cmd == "test" {
        out = host.tempDir() + "/finch_run_" + str(host.pid()) + "_" + stem(file) + tg.exe
    } else if shared && !outGiven {
        if tg.windows {
            out = out + ".dll"
        } else if tg.darwin {
            out = "lib" + out + ".dylib"
        } else {
            out = "lib" + out + ".so"
        }
    } else if !outGiven {
        out = out + tg.exe
    }

    loader := Loader()
    loader.os = "linux"
    if tg.windows {
        loader.os = "windows"
    } else if tg.darwin {
        loader.os = "macos"
    }
    for cand in [dirOf(args[0]) + "/../std", dirOf(args[0]) + "/std", dirOf(args[0]) + "/../share/finch/std", "std"] {
        if loader.std.len == 0 && file_exists(cand + "/path.fch") {
            loader.std = cand
        }
    }
    if loader.std.len == 0 {
        loader.std = unpack() + "/std"
    }
    loader.overlayPaths = overlayPaths
    loader.overlayFiles = overlayFiles
    for d in getenv("FINCH_PATH").split(host.pathSeparator()) {
        if d.len > 0 {
            loader.paths.push(d)
        }
    }
    load(addr(loader), file, "")

    // C headers, from every file; their folders are searched first for "local.h"
    []cimport.Header headers
    []str seen
    []str dirs = extraDirs
    []str links = extraLibs
    for prog in loader.progs {
        d := dirOf(prog.path)
        if !dirs.contains(d) {
            dirs.push(d)
        }
        for i in 0..prog.cimports.len {
            if !seen.contains(prog.cimports[i]) {
                seen.push(prog.cimports[i])
                headers.push(cimport.Header(path: prog.cimports[i], where: prog.cwhere[i]))
            }
        }
        for l in prog.links {
            if l.ends_with(".c") || l.ends_with(".o") || l.ends_with(".a") {
                links.push(d + "/" + l)             // the program's own C code, next to the .fch file
            } else {
                links.push(l)
            }
        }
    }
    triple := ""
    if tg.cross || tg.windows {
        triple = tg.triple          // on Windows libclang.dll would otherwise assume MSVC, while clang may be MinGW
    }
    ci := cimport.importHeaders(headers, dirs, triple, tg.windows, tg.cc) or {
        print(err)
        return 1
    }
    []str testModules
    for prog in loader.progs {
        if !prog.path.starts_with(loader.std + "/") {
            testModules.push(prog.module)       // your own files' tests, not the standard library's
        }
    }
    ir := gen.generate(loader.progs, loader.files, ci, gen.Options(shared: shared, debug: debug, index: cmd == "index", cwd: host.cwd(), target: tg, test: cmd == "test", testModules: testModules, trace: trace))
    if cmd == "ir" || cmd == "index" {
        print(ir)
        return 0
    }

    // the runtime is Finch's C file; FINCH_RT can point somewhere else
    rt := getenv("FINCH_RT")
    if rt.len == 0 {
        rt = dirOf(args[0]) + "/../runtime/finch_rt.c"
    }
    if !file_exists(rt) {
        rt = dirOf(args[0]) + "/runtime/finch_rt.c"
    }
    if !file_exists(rt) {
        rt = dirOf(args[0]) + "/../share/finch/runtime/finch_rt.c"
    }
    if !file_exists(rt) && file_exists("runtime/finch_rt.c") {
        rt = "runtime/finch_rt.c"
    }
    if !file_exists(rt) {
        rt = unpack() + "/runtime/finch_rt.c"
    }
    extra := ""
    if shared {
        extra = " -fPIC"
    }
    if debug {
        extra = extra + " -g"      // or clang drops the debug info that is in the IR
    }
    []str cflagList
    for d in extraDirs {
        cflagList.push(" -I" + linker.quote(d))
    }
    if linker.build(linker.Build(out: out, ir: ir, rt: rt, opt: opt, extra: extra, shared: shared, links: links, name: absolute(file), cflags: cflagList.join("")), tg, ci) != 0 {
        return 1
    }
    if cmd == "run" || cmd == "test" {
        []str quoted
        for a in progArgs {
            quoted.push(linker.quote(a))
        }
        status := host.run(tg.runner + linker.quote(out) + " " + quoted.join(" "))
        host.remove(out)
        return status
    }
    return 0
}
