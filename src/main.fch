// finch: the Finch compiler, written in Finch (`finch` with no arguments lists the commands).
//
// It reads the program and the modules it imports, checks it, writes LLVM IR as text
// and lets clang turn that into a program, linked with Finch's C runtime.
import lexer
import ast
import parser
import gen
import cimport
import platform
import linker
import lsp
import host
import embedded
import manifest
import fmt
import diag
import "stdlib.h"

fn version() -> str {
    return "2.7.0"
}

fn dirOf(str path) -> str {
    i := path.len - 1
    while i >= 0 && path[i] != '/' {
        i -= 1
    }
    if i < 0 {
        return "."
    }
    return path.sub(0, i)
}

// the path from the root, so the same file is the same in the cache wherever finch is started
fn absolute(str path) -> str {
    if path.starts_with("/") || (path.len > 2 && path[1] == ':') {
        return path
    }
    return host.cwd() + "/" + path
}

fn stem(str path) -> str {
    name := path.sub(dirOf(path).len + 1, path.len)
    if dirOf(path) == "." && !path.starts_with("./") {
        name = path
    }
    dot := name.find(".")
    if dot > 0 {
        return name.sub(0, dot)
    }
    return name
}

struct Loader {
    []ast.Program progs
    []str files
    []str loaded
    bool plain          // finch index: errors as one line each, for the language server
    str os              // "windows", "macos" or "linux": a module may have a version for each (time_windows.fch)
    str std             // the standard library's folder, or ""
    []str paths         // FINCH_PATH: more folders to look for modules in
    str root            // the main file's folder: modules are named by their path from here (ui/button)
    []str overlayPaths  // --overlay path=file: read `path` from `file` (the text an editor has, not saved yet)
    []str overlayFiles
}

fn textOfFile(ptr[Loader] l, str path) -> str {
    k := l.overlayPaths.find(path)
    if k >= 0 {
        return read_file(l.overlayFiles[k])
    }
    return read_file(path)
}

// import json: the file next to the one that imports it, else the standard library's.
// A program's own json.fch wins over the library's.
fn findModule(ptr[Loader] l, str from, str name) -> str {
    // in each folder, the version for this system first: time_windows.fch, then time.fch
    local := dirOf(from) + "/" + name + ".fch"
    if file_exists(dirOf(from) + "/" + name + "_" + l.os + ".fch") {
        return dirOf(from) + "/" + name + "_" + l.os + ".fch"
    }
    if file_exists(local) {
        return local
    }
    for d in l.paths {
        if file_exists(d + "/" + name + "_" + l.os + ".fch") {
            return d + "/" + name + "_" + l.os + ".fch"
        }
        if file_exists(d + "/" + name + ".fch") {
            return d + "/" + name + ".fch"
        }
    }
    if l.std.len > 0 {
        if file_exists(l.std + "/" + name + "_" + l.os + ".fch") {
            return l.std + "/" + name + "_" + l.os + ".fch"
        }
        if file_exists(l.std + "/" + name + ".fch") {
            return l.std + "/" + name + ".fch"
        }
    }
    return local
}

// A module is named by its file, so `import button` in ui/menu.fch and `import ui/button` in main.fch
// are the same module, and two different util.fch files are two modules.
fn moduleKey(ptr[Loader] l, str file, str name) -> str {
    []str roots
    roots.push(l.root)
    for d in l.paths {
        roots.push(d)
    }
    roots.push(l.std)
    for r in roots {
        if r.len > 0 && file.starts_with(r + "/") && file.ends_with(".fch") {
            key := file.sub(r.len + 1, file.len - 4)
            if key.ends_with("_" + l.os) {
                key = key.sub(0, key.len - l.os.len - 1)        // time_windows.fch is the module time
            }
            return key
        }
    }
    return name
}

fn load(ptr[Loader] l, str path, str module) {
    if !file_exists(path) && !l.overlayPaths.contains(path) {
        if module.len > 0 {
            diag.problem("can't find the module '" + module + "' (looked for " + path + ")")
        } else {
            diag.problem("can't open '" + path + "'")
        }
        exit(1)
    }
    src := textOfFile(l, path)
    file := l.files.len
    l.files.push(path)
    prog := parser.parse(lexer.lex(src, path, l.plain), file, path, l.plain)
    prog.module = module
    prog.path = path
    if module.len == 0 {
        l.root = dirOf(path)
    }
    []str files
    for i in 0..prog.modules.len {
        f := findModule(l, path, prog.modules[i])
        files.push(f)
        prog.modules[i] = moduleKey(l, f, prog.modules[i])
    }
    modules := prog.modules
    l.progs.push(prog)
    for i in 0..modules.len {
        if !l.loaded.contains(modules[i]) {
            l.loaded.push(modules[i])
            load(l, files[i], modules[i])
        }
    }
}

fn usage(int code) {
    on := diag.colors()
    head := fn_head(on)
    print(head)
    print("")
    print(diag.paint(on, "1", "Usage:") + " finch <command> [file.fch] [options]")
    print("")
    print(diag.paint(on, "1", "Commands:"))
    line(on, "run <file> [args...]", "build and run a program")
    line(on, "build <file> [-o name]", "build a program you can share")
    line(on, "test <file>", "run its  test \"...\" { }  blocks (and those of the modules it imports)")
    line(on, "fmt [--check] [files]", "tidy the indentation of .fch files (--check: only list what it would change)")
    line(on, "ir <file>", "show the LLVM IR the program turns into")
    line(on, "lsp", "the language server, for editors (VS Code, Kate, ...)")
    line(on, "version", "show the version")
    line(on, "help", "this list")
    print("  " + diag.paint(on, "2", "With a finch.toml, run, build and test can leave out the file: its entry is used."))
    print("")
    print(diag.paint(on, "1", "Options:"))
    line(on, "-O0", "no optimization (faster to build)")
    line(on, "-g", "debug info, for gdb and lldb (use -O0 with it)")
    line(on, "-l <lib>", "link a library (the same as  link \"lib\"  in the program)")
    line(on, "-I <dir>", "look for imported C headers there too")
    line(on, "--trace / --no-trace", "runtime errors show the chain of calls, or don't (on for run, test, -g, -O0)")
    line(on, "--target <name>", "build for another system: windows, linux, arm64, macos, android, or an LLVM triple")
    line(on, "--cpu <name>", "use all of a processor's instructions: native (this one), x86-64-v3, apple-m1, ...")
    line(on, "--shared", "build a library a C program can load (its  export fn  are the C functions)")
    print("")
    print(diag.paint(on, "1", "Environment:"))
    line(on, "FINCH_COLOR=never", "no colours (or NO_COLOR=1); =always keeps them in pipes too")
    line(on, "FINCH_CC, FINCH_PATH", "the C compiler that links; more folders to find modules in")
    print("")
    print(diag.paint(on, "2", "Start with:  finch run hello.fch      Guides: docs/en (English), docs/pl (polski)"))
    exit(code)
}

fn systemName(platform.Target tg) -> str {
    cpu := "x86-64"
    if tg.arm64 {
        cpu = "ARM64"
    }
    if tg.windows {
        return cpu + " Windows"
    }
    if tg.darwin {
        return cpu + " macOS"
    }
    if tg.android {
        return cpu + " Android"
    }
    return cpu + " Linux"
}

fn fn_head(bool on) -> str {
    return diag.paint(on, "1;33", "Finch " + version()) + "  " + diag.paint(on, "2", "small, quick, sharp -- a compiler written in Finch")
}

fn line(bool on, str what, str says) {
    pad := 24 - what.len
    if pad < 2 {
        pad = 2
    }
    print("  " + diag.paint(on, "1;32", what) + " ".repeat(pad) + says)
}

// The runtime and the standard library are carried inside the compiler (embedded.fch). When they aren't found as
// files next to it, they are written to the cache folder, once, and used from there.
fn unpack() -> str {
    names := embedded.names()
    dir := host.cacheDir() + "/files-" + linker.fingerprint(embedded.texts().join("\n"))
    if file_exists(dir + "/done") {
        return dir
    }
    texts := embedded.texts()
    for i in 0..names.len {
        host.makeDirs(dirOf(dir + "/" + names[i]))
        write_file(dir + "/" + names[i], texts[i])
    }
    write_file(dir + "/done", "")
    return dir
}

// finch fmt [--check] [files or folders]: the indentation and empty lines of .fch files (all under here by default)
fn format([]str args) -> int {
    check := false
    []str targets
    for i in 2..args.len {
        if args[i] == "--check" {
            check = true
        } else {
            targets.push(args[i])
        }
    }
    if targets.len == 0 {
        targets.push(".")
    }
    []str files
    for t in targets {
        if t.ends_with(".fch") {
            files.push(t)
        } else {
            for f in host.listFiles(t, ".fch") {
                files.push(f)
            }
        }
    }
    changed := 0
    for f in files {
        text := read_file(f) or {
            diag.problem("can't read " + f)
            return 1
        }
        neat := fmt.format(text)
        if neat != text {
            changed += 1
            if check {
                print(f)
            } else {
                write_file(f, neat)
            }
        }
    }
    if check && changed > 0 {
        print(str(changed) + " file(s) are not formatted (finch fmt changes them)")
        return 1
    }
    return 0
}

fn main([]str args) -> int {
    started := host.millis()
    if args.len == 2 && (args[1] == "version" || args[1] == "--version") {
        print(fn_head(diag.colors()))
        return 0
    }
    if args.len == 2 && (args[1] == "help" || args[1] == "--help" || args[1] == "-h") {
        usage(0)
    }
    if args.len >= 2 && args[1] == "fmt" {
        return format(args)
    }
    if args.len == 2 && args[1] == "lsp" {
        return lsp.run(args[0])             // the language server, for editors
    }
    if args.len < 2 {
        usage(1)
    }
    cmd := args[1]
    if cmd != "build" && cmd != "run" && cmd != "ir" && cmd != "index" && cmd != "test" {
        diag.problem("'" + cmd + "' is not a command of finch (try: finch help)")
        exit(1)
    }
    file := ""
    ai := 2
    if args.len > 2 && !args[2].starts_with("-") {
        file = args[2]
        ai = 3
    }
    // finch.toml: next to the file, or above it (with no file: from here, and its entry is the file)
    from := host.cwd()
    if file.len > 0 {
        from = dirOf(absolute(file))
    }
    man := manifest.find(from) or {
        diag.passOn(err)
        return 1
    }
    isEntry := file.len == 0
    if isEntry {
        entry := man.value("entry", "")
        if !man.found || entry.len == 0 {
            diag.problem("which file? (finch " + cmd + " <file.fch>, or a finch.toml with  entry = \"main.fch\")")
            return 1
        }
        file = man.resolve(entry)
    }
    out := stem(file)
    if isEntry && man.value("name", "").len > 0 {      // another file of the project keeps its own name
        out = man.value("name", "")
    }
    outGiven := false
    shared := false
    debug := false
    trace := cmd != "build"         // finch build: only with --trace, -g or -O0 (the chain costs speed)
    traceGiven := false
    targetName := ""
    cpu := ""
    opt := "-O2"
    []str extraLibs
    []str extraDirs
    []str overlayPaths
    []str overlayFiles
    []str progArgs
    while ai < args.len {
        a := args[ai]
        if cmd == "run" && progArgs.len > 0 {          // after the first argument of the program, all of them are its
            progArgs.push(a)
        } else if a == "-o" && ai + 1 < args.len && cmd == "build" {
            out = args[ai + 1]
            outGiven = true
            ai += 1
        } else if a == "--shared" && cmd == "build" {
            shared = true
        } else if a == "-O0" {
            opt = "-O0"
        } else if a == "-l" && ai + 1 < args.len {
            extraLibs.push(args[ai + 1])
            ai += 1
        } else if a.starts_with("-l") && a.len > 2 {
            extraLibs.push(a.sub(2, a.len))
        } else if a == "-I" && ai + 1 < args.len {
            extraDirs.push(args[ai + 1])
            ai += 1
        } else if a == "--overlay" && ai + 1 < args.len {
            both := args[ai + 1].split("=")
            overlayPaths.push(both[0])
            overlayFiles.push(both[1])
            ai += 1
        } else if a == "-g" {
            debug = true
        } else if a == "--no-trace" {
            trace = false
            traceGiven = true
        } else if a == "--trace" {
            trace = true
            traceGiven = true
        } else if a == "--target" && ai + 1 < args.len {
            targetName = args[ai + 1]
            ai += 1
        } else if a == "--cpu" && ai + 1 < args.len {
            cpu = args[ai + 1]
            ai += 1
        } else if cmd == "run" {
            progArgs.push(a)
        } else {
            diag.problem("'" + a + "' is not an option of finch " + cmd + " (try: finch help)")
            exit(1)
        }
        ai += 1
    }
    if !traceGiven && (debug || opt == "-O0") {
        trace = true
    }
    tg := platform.select(targetName)
    if cmd == "run" || cmd == "test" {
        out = host.tempDir() + "/finch_run_" + str(host.pid()) + "_" + stem(file) + tg.exe
    } else if shared && !outGiven {
        if tg.windows {
            out = out + ".dll"
        } else if tg.darwin {
            out = "lib" + out + ".dylib"
        } else {
            out = "lib" + out + ".so"
        }
    } else if !outGiven {
        out = out + tg.exe
    }

    loader := Loader(plain: cmd == "index")
    loader.os = "linux"
    if tg.windows {
        loader.os = "windows"
    } else if tg.darwin {
        loader.os = "macos"
    }
    for cand in [dirOf(args[0]) + "/../std", dirOf(args[0]) + "/std", dirOf(args[0]) + "/../share/finch/std", "std"] {
        if loader.std.len == 0 && file_exists(cand + "/path.fch") {
            loader.std = cand
        }
    }
    if loader.std.len == 0 {
        loader.std = unpack() + "/std"
    }
    loader.overlayPaths = overlayPaths
    loader.overlayFiles = overlayFiles
    // what finch.toml adds, for every system and for this one
    []str targets
    sys := "linux"
    if tg.windows {
        sys = "windows"
    } else if tg.darwin {
        sys = "macos"
    } else if tg.android {
        sys = "android"
    }
    arch := "x86_64"
    if tg.arm64 {
        arch = "arm64"
    }
    targets.push(sys)
    targets.push(sys + "-" + arch)
    ldflags := ""
    cflags := ""
    if man.found {
        for d in man.list("paths", targets) {
            loader.paths.push(man.resolve(d))
        }
        for d in man.list("include", targets) {
            extraDirs.push(man.resolve(d))
        }
        for l in man.list("links", targets) {
            if l.ends_with(".c") || l.ends_with(".o") || l.ends_with(".a") || l.ends_with(".cpp") || l.ends_with(".cc") || l.ends_with("Cargo.toml") {
                extraLibs.push(man.resolve(l))
            } else {
                extraLibs.push(l)
            }
        }
        for d in man.list("libdirs", targets) {
            ldflags = ldflags + " -L" + linker.quote(man.resolve(d))
        }
        for f in man.list("ldflags", targets) {
            ldflags = ldflags + " " + linker.quote(f)
        }
        for f in man.list("cflags", targets) {
            cflags = cflags + " " + linker.quote(f)
        }
        if cpu.len == 0 {
            cpu = man.value("cpu", "")
        }
    }
    for d in getenv("FINCH_PATH").split(host.pathSeparator()) {
        if d.len > 0 {
            loader.paths.push(d)
        }
    }
    load(addr(loader), file, "")

    // C headers, from every file; their folders are searched first for "local.h"
    []cimport.Header headers
    []str seen
    []str dirs = extraDirs
    []str links = extraLibs
    for prog in loader.progs {
        d := dirOf(prog.path)
        if !dirs.contains(d) {
            dirs.push(d)
        }
        for i in 0..prog.cimports.len {
            if !seen.contains(prog.cimports[i]) {
                seen.push(prog.cimports[i])
                if prog.cimports[i].ends_with("Cargo.toml") {
                    // a Rust crate: its header from cbindgen, and the crate itself linked
                    manifest := d + "/" + prog.cimports[i]
                    header := linker.rustHeader(manifest) or {
                        diag.passOn(prog.cwhere[i] + ": error: " + err)
                        return 1
                    }
                    headers.push(cimport.Header(path: header, where: prog.cwhere[i]))
                    if !links.contains(manifest) {
                        links.push(manifest)
                    }
                    continue
                }
                headers.push(cimport.Header(path: prog.cimports[i], where: prog.cwhere[i]))
            }
        }
        for l in prog.links {
            if linker.isOwnCode(l) {
                links.push(d + "/" + l)             // the program's own C code, next to the .fch file
            } else {
                links.push(l)
            }
        }
    }
    triple := ""
    if tg.cross || tg.windows {
        triple = tg.triple          // on Windows libclang.dll would otherwise assume MSVC, while clang may be MinGW
    }
    ci := cimport.importHeaders(headers, dirs, triple, tg.windows, tg.cc) or {
        diag.passOn(err)
        return 1
    }
    for f in ci.cppFiles {
        links.push(f)               // the C wrappers of a C++ header, built with the C++ compiler
    }
    []str testModules
    for prog in loader.progs {
        if !prog.path.starts_with(loader.std + "/") {
            testModules.push(prog.module)       // your own files' tests, not the standard library's
        }
    }
    // what the processor can do (dot_add and the like pick their instructions by it); not needed for the editor's index
    []str features
    if cmd != "index" {
        features = linker.cpuFeatures(tg, cpu)
        if cpu == "native" && !tg.arm64 && !features.contains("sse4.2") {
            diag.notice("--cpu native made no difference to clang (a clang wrapper may remove -march=native; try --cpu with a name, like x86-64-v3)")
        }
    }
    ir := gen.generate(loader.progs, loader.files, ci, gen.Options(shared: shared, debug: debug, index: cmd == "index", cwd: host.cwd(), target: tg, test: cmd == "test", testModules: testModules, trace: trace, features: features))
    if cmd == "ir" || cmd == "index" {
        print(ir)
        return 0
    }

    // the runtime is Finch's C file; FINCH_RT can point somewhere else
    rt := getenv("FINCH_RT")
    if rt.len == 0 {
        rt = dirOf(args[0]) + "/../runtime/finch_rt.c"
    }
    if !file_exists(rt) {
        rt = dirOf(args[0]) + "/runtime/finch_rt.c"
    }
    if !file_exists(rt) {
        rt = dirOf(args[0]) + "/../share/finch/runtime/finch_rt.c"
    }
    if !file_exists(rt) && file_exists("runtime/finch_rt.c") {
        rt = "runtime/finch_rt.c"
    }
    if !file_exists(rt) {
        rt = unpack() + "/runtime/finch_rt.c"
    }
    extra := ""
    if shared {
        extra = " -fPIC"
    }
    if debug {
        extra = extra + " -g"      // or clang drops the debug info that is in the IR
    }
    extra = extra + linker.cpuFlag(tg, cpu)          // x86-64 names a processor with -march, ARM with -mcpu
    []str cflagList
    for d in dirs {
        cflagList.push(" -I" + linker.quote(d))      // also the program's own folders (its headers, for inline C functions)
    }
    cflagList.push(cflags)
    if linker.build(linker.Build(out: out, ir: ir, rt: rt, opt: opt, extra: extra, shared: shared, links: links, name: absolute(file), cflags: cflagList.join(""), ldflags: ldflags), tg, ci) != 0 {
        return 1
    }
    took := diag.seconds(host.millis() - started)
    if cmd == "build" {
        how := "optimized"
        if opt == "-O0" {
            how = "not optimized"
        }
        if debug {
            how += ", with debug info"
        }
        diag.status("Built", out, "in " + took, how + ", " + systemName(tg))
    } else if cmd == "run" {
        diag.status("Running", stem(file), "", "built in " + took)
    } else {
        diag.status("Testing", stem(file), "", "built in " + took)
    }
    if cmd == "run" || cmd == "test" {
        []str quoted
        for a in progArgs {
            quoted.push(linker.quote(a))
        }
        status := host.run(tg.runner + linker.quote(out) + " " + quoted.join(" "))
        host.remove(out)
        return status
    }
    return 0
}
