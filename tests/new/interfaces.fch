// interfaces: what a type can do; any struct or enum with those methods is one
interface Shape {
    fn area() -> float
    fn name() -> str
}

interface Counter {
    fn add(int n)
    fn total() -> int
}

interface Parser {
    fn parse(str s) -> int!
}

struct Circle {
    float r
}

struct Rect {
    float w
    float h
    []str tags
}

enum Dir { Up, Down }

struct Tally {
    int n
}

struct Strict {
    int max
}

struct Box[T] {
    T item
}

fn Circle.area() -> float {
    return 3.0 * self.r * self.r
}

fn Circle.name() -> str {
    return "circle"
}

fn Rect.area() -> float {
    return self.w * self.h
}

fn Rect.name() -> str {
    return "rect " + self.tags.join("+")
}

fn Dir.area() -> float {
    return 0.0
}

fn Dir.name() -> str {
    if self == Dir.Up {
        return "up"
    }
    return "down"
}

fn Tally.add(int n) {
    self.n += n
}

fn Tally.total() -> int {
    return self.n
}

fn Strict.parse(str s) -> int! {
    n := try int(s)
    if n > self.max {
        return error("too big")
    }
    return n
}

fn Box[T].area() -> float {
    return 1.0
}

fn Box[T].name() -> str {
    return "box of " + str(self.item)
}

fn total_area([]Shape shapes) -> float {
    sum := 0.0
    for s in shapes {
        sum += s.area()
    }
    return sum
}

fn biggest([]Shape shapes) -> Shape? {
    Shape? best
    best_area := -1.0
    for s in shapes {
        if s.area() > best_area {
            best = s
            best_area = s.area()
        }
    }
    return best
}

struct Scene {
    str title
    Shape main
}

fn main() {
    []Shape shapes = [Circle(1.0), Rect(w: 2.0, h: 3.0, tags: ["red", "big"]), Dir.Up, Box[int](7)]
    for s in shapes {
        print(s.name(), s.area())
    }
    print(total_area(shapes))
    print(shapes)

    if b := biggest(shapes) {
        print("biggest:", b.name())
    }
    shapes.sort_by(fn(a, b) { return a.area() < b.area() })
    print(shapes.map(fn(Shape s) -> str { return s.name() }))

    Counter c = Tally(0)
    c.add(5)
    c.add(2)
    copy := c
    copy.add(100)
    print(c.total(), copy.total())

    Parser p = Strict(10)
    print(p.parse("7") or -1, p.parse("70") or -1, p.parse("x") or -2)

    scene := Scene(title: "demo", main: Circle(2.0))
    print(scene.main.name(), scene.main.area(), scene)

    Shape empty
    print(empty)
}
