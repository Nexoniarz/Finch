// mut parameters: the function changes the caller's own variable, without pointers
struct Player {
    str name
    int hp
    []str items
}

fn grow(mut []int list, int n) {
    for i in 0..n {
        list.push(i)
    }
}

fn twice(mut []int list) {
    grow(mut list, 2)           // a mut parameter passed on
    grow(mut list, 1)
}

fn heal(mut Player p, int by) {
    p.hp += by
    p.items.push("potion")
}

fn rename(mut str s) {
    s = s.upper() + "!"
}

fn bump(mut int n) {
    n += 1
}

fn reset(mut []int list) {
    list = [9, 9]                // the whole value, replaced (the old one is freed)
}

fn total(mut []int list) -> int {
    sum := 0
    for x in list {
        sum += x
    }
    return sum
}

fn kept(mut []int list) -> []int {
    return list                  // a copy: the caller still has its own
}

fn swap[T](mut T a, mut T b) {
    t := a
    a = b
    b = t
}

fn add_all[T](mut []T list, []T more) {
    for x in more {
        list.push(x)
    }
}

fn Player.give(mut []str from) {
    while from.len > 0 {
        self.items.push(from.pop())
    }
}

fn main() {
    nums := [1]
    grow(mut nums, 3)
    print(nums)
    twice(mut nums)
    print(nums, total(mut nums))

    p := Player(name: "ann", hp: 10)
    heal(mut p, 5)
    print(p.hp, p.items)
    bump(mut p.hp)
    rename(mut p.name)
    print(p.name, p.hp)

    team := [Player(name: "a"), Player(name: "b")]
    heal(mut team[1], 3)
    bump(mut team[0].hp)
    print(team[0].hp, team[1].hp, team[1].items)

    k := kept(mut nums)
    k.push(100)
    print(nums.len, k.len)
    reset(mut nums)
    print(nums)

    x := "left"
    y := "right"
    swap(mut x, mut y)
    print(x, y)
    i := 1
    j := 2
    swap(mut i, mut j)
    print(i, j)

    words := ["x"]
    add_all(mut words, ["y", "z"])
    print(words)

    bag := ["sword", "shield"]
    p.give(mut bag)
    print(p.items, bag.len)

    n := 0
    for r in 0..3 {
        bump(mut n)
    }
    print(n)
}
