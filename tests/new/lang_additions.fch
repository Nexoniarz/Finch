// const, if as a value, min/max/abs/clamp, import a/b and import x as y, """ text
import ui/button
import path as p
import ui/button as b2

const W = 640
const H = W / 2
const f32 G = 9.8
const TITLE = "Game " + "One"
const NEG = -W

fn main() {
    print(W, H, G, TITLE, NEG, button.SIZE)
    bt := button.make("ok")
    button.Button other
    print(bt.label, bt.w, other.w, b2.make("x").w)
    print(p.base("/a/b.txt"))
    x := 7
    v := if x > 5 { "big" } else if x > 2 { "mid" } else { "small" }
    f32 s = if x > 5 { 1.5 } else { 0.5 }
    print(v, s, if x == 7 { x * 2 } else { 0 })
    print(min(3, 9), max(2.5, 1), abs(-4), abs(-2.5), clamp(15, 0, 10), clamp(-3, 0, 10), min(5, 2, 8))
    f32 sp = 2.0
    print(clamp(sp * 3.0, 0.0, 5.0), max(u8(3), u8(200)))
    shader := """
        #version 330
        void main() {
            gl_Position = vec4(0.0);
        }
        """
    print(shader)
    print("""one "quoted" line""")
}
