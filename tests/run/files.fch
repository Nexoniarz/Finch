fn main() {
    path := "finch_test_file.txt"
    ok := write_file(path, "line one\nline two\n")
    print(ok, file_exists(path))
    text := read_file(path)
    lines := text.trim().split("\n")
    print(lines, lines.len)
    print(delete_file(path), file_exists(path))
    print(file_exists("definitely/not/here"))
}
