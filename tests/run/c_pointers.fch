import "string.h"

struct Point {
    int x
    int y
}

fn main() {
    p := Point(
        x: 1,
        y: 2,
    )
    print(p)
    c := "finch".ptr
    print(c[1], strlen("finch"))
    q := ptr(4096)
    print(int(q), int(ptr(0)) == 0, q != null)
    a := [10, 20, 30]
    address := int(a.ptr)
    ptr[int] second = ptr(address + 8)
    print(second.value)
}
